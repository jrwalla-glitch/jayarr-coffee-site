---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

// Every YouTube video in each post, not just its first (round 3, item 21): LiteYouTube embeds and plain
// youtube.com/embed iframes, in page order. A video embedded in more than one post is listed once, under the post
// that carries it as its own front-matter videoId (the earliest such post), else under the earliest post.
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const attr = (tag: string, name: string) =>
	tag.match(new RegExp(`\\b${name}=(?:"([^"]*)"|\\{\\s*'((?:[^'\\\\]|\\\\.)*)'\\s*\\}|\\{\\s*"((?:[^"\\\\]|\\\\.)*)"\\s*\\})`))?.slice(1).find((v) => v !== undefined)?.replace(/\\(.)/g, '$1');
const found: { videoId: string; videoTitle: string; post: (typeof allPosts)[number]; order: number }[] = [];
for (const post of allPosts) {
	const body = post.body || '';
	let order = 0;
	for (const m of body.matchAll(/<LiteYouTube\b[^>]*>|youtube(?:-nocookie)?\.com\/embed\/([a-zA-Z0-9_-]+)/g)) {
		const id = m[1] ?? attr(m[0], 'videoId');
		if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) continue;
		found.push({ videoId: id, videoTitle: (m[1] ? '' : attr(m[0], 'title')) || post.data.title, post, order: order++ });
	}
}
const owner = new Map<string, (typeof found)[number]>();
for (const f of found) {
	const cur = owner.get(f.videoId);
	const own = (x: (typeof found)[number]) => x.post.data.videoId === x.videoId;
	const better = !cur || (own(f) && !own(cur)) || (own(f) === own(cur) && f.post.data.pubDate.valueOf() < cur.post.data.pubDate.valueOf());
	if (better) owner.set(f.videoId, f);
}
const videoPosts = [...owner.values()]
	.sort((a, b) => b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf() || a.order - b.order)
	.map((f) => ({ title: f.videoTitle, postTitle: f.post.data.title, videoId: f.videoId, slug: f.post.id }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Videos — ${SITE_TITLE}`} description="Watch JayArr Coffee videos — coffee scoring, reviews, brewing science, and more." />
	</head>
	<body class="bg-cream">
		<Header />

		<!-- Page header -->
		<div class="pt-32 pb-16 bg-charcoal">
			<div class="max-w-6xl mx-auto px-6">
				<span class="text-xs uppercase tracking-widest text-copper font-medium">Watch</span>
				<h1 class="font-serif text-5xl md:text-6xl font-bold text-cream mt-2">Videos</h1>
				<p class="text-cream/60 mt-4 max-w-2xl">
					{videoPosts.length} videos — in-depth coffee content from scoring breakdowns to brewing science.
					Subscribe on <a href="https://www.youtube.com/@jayarrcoffee" target="_blank" rel="noopener" class="text-copper hover:text-copper-light underline underline-offset-2">YouTube</a> for new videos.
				</p>
			</div>
		</div>

		<main class="max-w-6xl mx-auto px-6 py-16">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{videoPosts.map((video) => (
					<div>
						<div class="aspect-video rounded-sm overflow-hidden bg-charcoal">
							<LiteYouTube videoId={video.videoId} title={video.title} />
						</div>
						<a href={`/blog/${video.slug}/`} class="block mt-3 group">
							<h3 class="font-serif text-base font-bold text-charcoal group-hover:text-copper transition-colors leading-snug">
								{video.title}
							</h3>
							<span class="text-xs text-copper mt-1 inline-block">{video.title === video.postTitle ? 'Read article' : `Read the article: ${video.postTitle}`} &rarr;</span>
						</a>
					</div>
				))}
			</div>

			<div class="text-center mt-16">
				<a href="https://www.youtube.com/@jayarrcoffee" target="_blank" rel="noopener" class="inline-block border border-charcoal text-charcoal px-8 py-3 text-sm uppercase tracking-widest hover:bg-charcoal hover:text-cream transition-all duration-300">
					Subscribe on YouTube
				</a>
			</div>
		</main>

		<Footer />
	</body>
</html>
