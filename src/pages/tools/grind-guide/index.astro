---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GrindGuide from '../../../components/coffee/GrindGuide.svelte';
import { METHODS, SOURCES } from '../../../lib/coffee/index.ts';

const title = 'Coffee Grind Size Chart: The Right Grind for Every Brewer';
const description = 'See what each grind should look like, from Turkish and espresso to French press and cold brew, with micrometre ranges, what too fine and too coarse taste like, and why a burr grinder matters.';
const order = ['espresso', 'moka', 'aeropress', 'v60', 'kalita', 'chemex', 'drip-machine', 'cold-brew', 'french-press'];
const rows = order.map((id) => METHODS.find((m) => m.id === id)!);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org', '@type': 'WebApplication', name: 'Grind Guide', url: 'https://jayarr.coffee/tools/grind-guide/', description,
			applicationCategory: 'UtilityApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'JayArr Coffee', url: 'https://jayarr.coffee' },
		})}></script>
	</head>
	<body class="cf-page">
		<Header />
		<main>
			<section class="cf-intro">
				<a href="/tools/" class="cf-back">← All tools</a>
				<p class="cf-kicker">Grind Guide</p>
				<h1>How fine should you grind <em>for your brewer?</em></h1>
				<p class="cf-lede">Pick a brewer to see its grind under a magnifier and on the scale from finest to coarsest, plus what going too fine or too coarse tastes like.</p>
			</section>
			<section class="cf-tool" aria-label="Grind Guide"><GrindGuide client:load /></section>

			<article class="cf-body">
				<h2>Grind size chart</h2>
				<div class="cf-table-wrap">
					<table>
						<thead><tr><th scope="col">Brewer</th><th scope="col">Grind</th><th scope="col" class="feel">Feels like</th><th scope="col">About</th></tr></thead>
						<tbody>
							<tr><th scope="row">Turkish</th><td>Extra fine<span class="feel-inline">like flour</span></td><td class="feel">flour</td><td>100–200 µm</td></tr>
							{rows.map((m) => <tr><th scope="row">{m.label}</th><td>{m.grindLabel}<span class="feel-inline">like {m.texture}</span></td><td class="feel">{m.texture}</td><td>{m.grindMicrons.min}–{m.grindMicrons.max} µm</td></tr>)}
						</tbody>
					</table>
				</div>
				<p class="cf-note">A micrometre (µm) is a thousandth of a millimetre. Ranges are typical starting points; every grinder's numbers differ, so use the <a href="/deep-brew/calibrator/">Grind Calibrator</a> for your model, then adjust by taste and brew time.</p>

				<h2>Why grind size matters so much</h2>
				<p>Grinding sets how much surface the water can reach and how fast it flows. Finer grounds extract faster and slow the water down; coarser grounds extract slower and let it run. That's why the same beans can taste sour from one grind and bitter from another, and why brew time is the best clue to whether you're too fine or too coarse.</p>
				<p>Consistency matters as much as size. Every grinder makes some fines (dust) alongside the main size, but a blade grinder makes far more dust and far more boulders. The dust over-extracts and turns bitter while the boulders under-extract and stay sour, so the cup tastes of both. Most of the coffee authors we draw on agree that a good burr grinder improves coffee more than any other piece of gear.</p>

				<h2>Adjusting from a starting point</h2>
				<ul>
					<li><strong>Sour, thin, finished fast:</strong> grind finer, one step at a time.</li>
					<li><strong>Bitter, dry, finished slow:</strong> grind coarser.</li>
					<li><strong>Light roasts</strong> usually want the finer end of the range; <strong>dark roasts</strong> the coarser end.</li>
					<li>Change only the grind between brews, so you know what made the difference.</li>
				</ul>

				<h2>Related guides</h2>
				<ul>
					<li><a href="/blog/coffee-grind-size-guide-what-grind-for-every-brew-method/">Coffee grind size guide</a></li>
					<li><a href="/blog/why-grinder-matters-more-than-machine/">Why the grinder matters more than the machine</a></li>
					<li><a href="/blog/conical-vs-flat-burr-grinders/">Conical vs flat burrs</a></li>
					<li><a href="/blog/turkish-coffee-guide/">Turkish coffee guide</a></li>
					<li><a href="/tools/fix-my-coffee/">Fix My Coffee</a></li>
				</ul>

				<h2>Sources</h2>
				<ul class="cf-sources">
					{['gagne', 'easto', 'rao', 'synthesis'].map((id) => SOURCES[id]).map((s) => <li>{s.author}, <cite>{s.title}</cite>{s.year ? ` (${s.year})` : ''}.</li>)}
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style is:global>.cf-page { background: #f3ede3; }</style>
<style>
	main { color: #2a1d15; }
	.cf-intro { max-width: 1180px; margin: 0 auto; padding: 120px 24px 22px; }
	.cf-back { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; text-decoration: none; }
	.cf-kicker { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 26px 0 0; }
	h1 { font: 400 clamp(40px, 6vw, 68px)/.98 'Instrument Serif', Georgia, serif; letter-spacing: -.01em; margin: 10px 0 12px; }
	h1 em { font-style: italic; color: #7a4e30; }
	.cf-lede { font: 400 17px/1.5 'IBM Plex Sans', system-ui, sans-serif; color: #5b4a3d; max-width: 60ch; margin: 0; }
	.cf-tool { max-width: 1180px; margin: 0 auto; padding: 8px 24px 40px; }
	.cf-body { max-width: 760px; margin: 0 auto; padding: 24px 24px 72px; font: 400 17px/1.7 'IBM Plex Sans', system-ui, sans-serif; }
	.cf-body h2 { font: 400 34px/1.1 'Instrument Serif', Georgia, serif; margin: 44px 0 12px; }
	.cf-body a { color: #7a4e30; text-underline-offset: 3px; }
	.cf-table-wrap { overflow-x: auto; border: 1px solid #d9cdbd; border-radius: 12px; background: #fbf8f3; }
	table { width: 100%; border-collapse: collapse; font-size: 15px; }
	th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid #e6dccd; white-space: nowrap; }
	thead th { font: 500 11px/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; }
	td:last-child { font-family: 'IBM Plex Mono', monospace; font-size: 14px; }
	tr:last-child th, tr:last-child td { border-bottom: 0; }
	.cf-note, .cf-sources { font-size: 14.5px; color: #5b4a3d; }
	.feel-inline { display: none; }
	@media (max-width: 640px) {
		/* Phones: three columns that fit, with the texture under the grind name instead of its own column. */
		.feel { display: none; }
		.feel-inline { display: block; font-size: 13px; color: #75655a; }
		th, td { white-space: normal; padding: 9px 10px; }
		td:last-child { white-space: nowrap; }
	}
	@media (max-width: 640px) { .cf-intro { padding: 96px 16px 18px; } .cf-tool { padding: 4px 12px 32px; } .cf-body { padding: 16px 16px 56px; } }
</style>
