		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "HowTo",
			"name": "How to Choose the Right Grind Size for Your Brew Method",
			"description": "Use the Grind Size Guide to find the correct micron range and texture reference for any coffee brew method, from Turkish to cold brew.",
