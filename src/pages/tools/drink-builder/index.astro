---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CoffeeDrinks from '../../../components/coffee/CoffeeDrinks.svelte';
import { DRINKS } from '../../../lib/coffee/index.ts';

const title = 'Types of Coffee Drinks, Drawn to Scale';
const description = 'Compare espresso drinks side by side, from espresso and cortado to flat white, cappuccino and latte, drawn to one scale from published recipes, with the regional differences that change them.';
const NAME: Record<string, string> = { espresso: 'espresso', milk: 'milk', frothed: 'frothed milk', foam: 'foam', water: 'hot water', brewed: 'brewed coffee', chocolate: 'chocolate', gelato: 'gelato', cream: 'whipped cream' };
const fmtLayer = (l: (typeof DRINKS)[number]['refs'][number]['layers'][number]) => {
	const r = l.ml ?? l.g;
	const unit = l.ml ? 'ml' : 'g';
	return r ? `${r[0] === r[1] ? r[0] : `${r[0]}–${r[1]}`} ${unit} ${NAME[l.kind] ?? l.kind}` : `${NAME[l.kind] ?? l.kind} (amount not published)`;
};
// Shot counts as readable text: "single shot", "three ristretto shots", "no espresso (drip coffee)".
const shotsText = (s: string) => s === 'single' ? 'single shot' : s === 'double' ? 'double shot' : s === 'not stated' ? 'shots not stated'
	: s.startsWith('none') ? `no espresso${s.slice(4)}` : s.startsWith('usually ') ? `usually a ${s.slice(8)} shot` : `${s} shots`;
const allSources = [...new Map(DRINKS.flatMap((d) => d.refs.map((r) => [r.source.url, r.source]))).values()];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org', '@type': 'WebApplication', name: 'Coffee Drinks', url: 'https://jayarr.coffee/tools/drink-builder/', description,
			applicationCategory: 'UtilityApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'JayArr Coffee', url: 'https://jayarr.coffee' },
		})}></script>
	</head>
	<body class="cf-page">
		<Header />
		<main>
			<section class="cf-intro">
				<a href="/tools/" class="cf-back">← All tools</a>
				<p class="cf-kicker">Coffee Drinks</p>
				<h1>Every espresso drink, <em>drawn to scale.</em></h1>
				<p class="cf-lede">Put two drinks side by side in their own cups, at the same scale, from published recipes. A cortado in Madrid and a cortado at Starbucks are not the same drink, so each recipe says where it comes from.</p>
			</section>
			<section class="cf-tool" aria-label="Coffee Drinks"><CoffeeDrinks client:load /></section>

			<article class="cf-body">
				<h2>Types of coffee drinks</h2>
				<p>Each entry gives one published reference recipe. Cafés vary, sometimes a lot; where a source gives a range, so do we.</p>
				<dl class="glossary">
					{DRINKS.map((d) => (
						<div id={d.id}>
							<dt>{d.name}</dt>
							<dd>
								<p>{d.definition}</p>
								<p class="ref">{d.refs[0].label}: {shotsText(d.refs[0].shots)}; {d.refs[0].layers.map(fmtLayer).join(', ')}; {d.refs[0].vessel.name.toLowerCase()}{d.refs[0].vessel.capacityMl ? ` (${d.refs[0].vessel.capacityMl[1]} ml)` : ''}. {d.refs.length > 1 ? `Also: ${d.refs.slice(1).map((r) => r.label).join(', ')}.` : ''}</p>
							</dd>
						</div>
					))}
				</dl>

				<h2>Latte vs cappuccino vs flat white</h2>
				<p>All three are espresso with steamed milk; the difference is how much milk and how much foam. In the Italian certification recipe a cappuccino is 25 ml of espresso and about 125 ml of frothed milk in a 150–160 ml cup, with a deep cap of foam. Cimbali's flat white uses a double shot with 125–130 ml of finely textured milk and only about half a centimetre of foam. A latte usually has the most milk of the three: illy's version is a single shot with 120 ml of milk heated without foam, and most cafés serve it larger with a thin layer of foam. The old "thirds" rule for cappuccino (equal espresso, milk and foam) has no historical basis.</p>

				<h2>A cortado depends on where you order it</h2>
				<p>In Spain a cortado is an espresso "cut" with a little milk: anything from a few drops to equal parts, with about three parts coffee to one part milk common. Specialty cafés often use a double shot. Starbucks' cortado is three ristretto shots with steamed milk in an 8 oz cup. The Gibraltar is a cortado named after the 4½ oz glass it was served in.</p>

				<h2>Related</h2>
				<ul>
					<li><a href="/blog/what-is-a-cortado/">What is a cortado?</a></li>
					<li><a href="/blog/what-is-a-flat-white-latte-vs-flat-white-comparison/">Flat white vs latte</a></li>
					<li><a href="/blog/affogato-recipe-guide/">Affogato recipe</a></li>
					<li><a href="/tools/caffeine/">How much caffeine is in each drink</a></li>
				</ul>

				<h2>Sources</h2>
				<ul class="cf-sources">{allSources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style is:global>.cf-page { background: #f3ede3; }</style>
<style>
	main { color: #2a1d15; }
	.cf-intro { max-width: 1180px; margin: 0 auto; padding: 120px 24px 22px; }
	.cf-back { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; text-decoration: none; }
	.cf-kicker { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 26px 0 0; }
	h1 { font: 400 clamp(40px, 6vw, 68px)/.98 'Instrument Serif', Georgia, serif; letter-spacing: -.01em; margin: 10px 0 12px; }
	h1 em { font-style: italic; color: #7a4e30; }
	.cf-lede { font: 400 17px/1.5 'IBM Plex Sans', system-ui, sans-serif; color: #5b4a3d; max-width: 62ch; margin: 0; }
	.cf-tool { max-width: 1180px; margin: 0 auto; padding: 8px 24px 40px; }
	.cf-body { max-width: 760px; margin: 0 auto; padding: 24px 24px 72px; font: 400 17px/1.7 'IBM Plex Sans', system-ui, sans-serif; }
	.cf-body h2 { font: 400 34px/1.1 'Instrument Serif', Georgia, serif; margin: 44px 0 12px; }
	.cf-body a { color: #7a4e30; text-underline-offset: 3px; }
	.glossary { margin: 0; }
	.glossary div { border-top: 1px solid #d9cdbd; padding: 12px 0; scroll-margin-top: 90px; }
	.glossary dt { font: 400 26px/1.1 'Instrument Serif', Georgia, serif; }
	.glossary dd { margin: 4px 0 0; }
	.glossary p { margin: 0 0 4px; }
	.glossary .ref { font: 400 14px/1.5 'IBM Plex Mono', monospace; color: #5b4a3d; }
	.cf-sources { font-size: 14px; color: #5b4a3d; }
	@media (max-width: 640px) { .cf-intro { padding: 96px 16px 18px; } .cf-tool { padding: 4px 12px 32px; } .cf-body { padding: 16px 16px 56px; } }
</style>
