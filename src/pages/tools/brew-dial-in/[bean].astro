---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import allBeans from '../../../data/brew-dial-in-beans.json';

export function getStaticPaths() {
  return allBeans.map((bean) => ({
    params: { bean: bean.id },
    props: { bean },
  }));
}

const { bean } = Astro.props;
const b = bean.bean;

const BREWER_NAMES = {
  'chemex-6cup': 'Chemex 6-Cup',
  'hario-v60-02': 'Hario V60-02',
  'kalita-wave-185': 'Kalita Wave 185',
  'aeropress': 'AeroPress',
  'clever-dripper': 'Clever Dripper',
  'espresso-generic': 'Espresso',
  'moka-pot': 'Moka Pot',
  'french-press': 'French Press',
  'cold-brew': 'Cold Brew',
};

const BREWER_ORDER = ['chemex-6cup','hario-v60-02','kalita-wave-185','aeropress','clever-dripper','espresso-generic','moka-pot','french-press','cold-brew'];

// Sort brewers by match score descending
const sortedBrewers = BREWER_ORDER
  .filter(br => bean.brewer_content[br])
  .sort((a, b) => (bean.brewer_content[b]?.match_score || 0) - (bean.brewer_content[a]?.match_score || 0));

const topBrewer = sortedBrewers[0];
const topContent = bean.brewer_content[topBrewer];

const roastDisplay = (b.roast_level || '').replace('_', '-');
const originDisplay = (b.origin || '').replace(/_/g, ' ');
const varietyDisplay = Array.isArray(b.variety) ? b.variety.join(', ') : (b.variety || '');

// Build HowTo schema for top brewer
const topRecipe = topContent?.recipe || {};
const howtoSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Brew ${b.name} on ${BREWER_NAMES[topBrewer] || topBrewer}`,
  "description": topContent?.why_paragraph?.substring(0, 160) || '',
  "totalTime": `PT${topRecipe.time_display || '4:00'}`,
  "supply": [
    { "@type": "HowToSupply", "name": `${b.name} by ${b.roaster}`, "requiredQuantity": `${topRecipe.dose_g?.start || 15}g` },
    { "@type": "HowToSupply", "name": "Water", "requiredQuantity": `${topRecipe.water_g?.start || 250}g at ${topRecipe.temp_c?.start || 94}°C` },
    { "@type": "HowToSupply", "name": `${topRecipe.grind_um?.start || 500}μm grind`, "requiredQuantity": `${topRecipe.dose_g?.start || 15}g ground coffee` },
  ],
  "tool": [
    { "@type": "HowToTool", "name": BREWER_NAMES[topBrewer] || topBrewer },
    { "@type": "HowToTool", "name": `Burr grinder (target ${topRecipe.grind_um?.start || 500}μm)` },
    { "@type": "HowToTool", "name": "Scale" },
    { "@type": "HowToTool", "name": "Kettle" },
  ],
  "step": [
    { "@type": "HowToStep", "name": "Grind", "text": `Grind ${topRecipe.dose_g?.start || 15}g of ${b.name} to ${topRecipe.grind_um?.start || 500}μm.` },
    { "@type": "HowToStep", "name": "Heat water", "text": `Heat ${topRecipe.water_g?.start || 250}g of water to ${topRecipe.temp_c?.start || 94}°C.` },
    { "@type": "HowToStep", "name": "Brew", "text": `Brew using ${BREWER_NAMES[topBrewer]}. Target brew time: ${topRecipe.time_display || '3:00-4:00'}.` },
  ],
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": b.name,
  "brand": { "@type": "Brand", "name": b.roaster },
  "description": (typeof bean.narrative === 'string' ? bean.narrative : bean.narrative?.text || '').substring(0, 200) || `${b.name} by ${b.roaster} — specialty coffee from ${originDisplay}.`,
  "category": "Coffee Beans",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Origin", "value": originDisplay },
    { "@type": "PropertyValue", "name": "Processing", "value": b.processing },
    { "@type": "PropertyValue", "name": "Roast Level", "value": roastDisplay },
    { "@type": "PropertyValue", "name": "Variety", "value": varietyDisplay },
  ].filter(p => p.value),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jayarr.coffee/" },
    { "@type": "ListItem", "position": 2, "name": "Brew Dial-In", "item": "https://jayarr.coffee/tools/brew-dial-in/" },
    { "@type": "ListItem", "position": 3, "name": b.roaster, "item": `https://jayarr.coffee/tools/brew-dial-in/?roaster=${encodeURIComponent(b.roaster)}` },
    { "@type": "ListItem", "position": 4, "name": b.name },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead
      title={`How to Brew ${b.name} by ${b.roaster} | Brew Dial-In | JayArr Coffee`}
      description={`Personalized brewing recipes for ${b.name} by ${b.roaster}. ${varietyDisplay} from ${originDisplay}, ${roastDisplay} roast. V60, Chemex, AeroPress, espresso, and 5 more methods.`}
    />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(howtoSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>

    <style>
      :root { --copper: #C17A3A; --dark: #1A1A1A; --muted: #6B6560; --cream: #FAF8F5; --cream-dark: #F0EDE8; --border: #E5E0D8; }
      body { font-family: 'Inter', -apple-system, sans-serif; color: var(--dark); background: var(--cream); margin: 0; }
      .bean-page { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      .breadcrumbs { font-size: 0.85rem; color: var(--muted); margin-bottom: 2rem; }
      .breadcrumbs a { color: var(--muted); text-decoration: none; }
      .breadcrumbs a:hover { color: var(--copper); }
      .breadcrumbs span { margin: 0 0.4rem; }

      /* Bean Header */
      .bean-header { margin-bottom: 2.5rem; }
      .roaster-line { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--copper); margin-bottom: 0.25rem; }
      .bean-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: var(--dark); margin: 0 0 0.75rem; line-height: 1.15; }
      .bean-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
      .meta-tag { font-size: 0.8rem; padding: 0.2rem 0.6rem; border: 1px solid var(--border); border-radius: 2px; color: var(--muted); }
      .flavor-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .flavor-tag { font-size: 0.8rem; padding: 0.2rem 0.6rem; background: var(--cream-dark); border-radius: 2px; color: var(--dark); }
      .copper-rule { width: 60px; height: 3px; background: var(--copper); border: none; margin: 1.5rem 0; }

      /* Narrative */
      .narrative { font-size: 1rem; line-height: 1.8; color: #3A3530; margin-bottom: 2.5rem; max-width: 70ch; }
      .narrative::first-letter { font-family: 'Playfair Display', serif; font-size: 3.2rem; float: left; line-height: 0.8; margin: 0.1em 0.12em 0 0; color: var(--copper); font-weight: 700; }

      /* Brewer Sections */
      .brewer-section { background: white; border: 1px solid var(--border); border-left: 3px solid var(--copper); border-radius: 2px; padding: 1.5rem; margin-bottom: 1rem; }
      .brewer-section.gated { border-left-color: #2e7d32; background: #fafff8; }
      .brewer-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem; }
      .brewer-name { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: var(--dark); }
      .match-score { font-size: 0.85rem; font-weight: 600; color: var(--copper); }
      .gated-badge { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #2e7d32; background: #e8f5e9; padding: 0.15rem 0.5rem; border-radius: 2px; }

      /* Recipe summary bar */
      .recipe-bar { display: flex; flex-wrap: wrap; gap: 1rem; padding: 0.6rem 0; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border); font-size: 0.8rem; color: var(--muted); }
      .recipe-param { white-space: nowrap; }
      .recipe-param strong { color: var(--dark); font-weight: 600; }

      .why-paragraph { font-size: 0.95rem; line-height: 1.75; color: #3A3530; }

      /* Troubleshooting */
      .troubleshooting { margin-top: 0.75rem; }
      .troubleshooting summary { font-size: 0.85rem; color: var(--copper); cursor: pointer; font-weight: 500; }
      .troubleshooting-item { padding: 0.4rem 0; font-size: 0.85rem; color: var(--muted); border-bottom: 1px solid var(--border); }
      .troubleshooting-item:last-child { border-bottom: none; }
      .issue-label { font-weight: 600; color: var(--dark); text-transform: capitalize; }

      /* Internal Links */
      .links-section { margin-top: 2.5rem; }
      .links-section h2 { font-family: 'Playfair Display', serif; font-size: 1.4rem; margin-bottom: 0.5rem; }
      .section-rule { width: 100%; height: 1px; background: var(--copper); opacity: 0.3; border: none; margin: 0.5rem 0 1rem; }
      .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
      .link-card { display: block; padding: 0.75rem; border: 1px solid var(--border); border-radius: 2px; text-decoration: none; color: var(--dark); font-size: 0.9rem; transition: border-color 0.2s; }
      .link-card:hover { border-color: var(--copper); }
      .link-card .card-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.15rem; }
      .link-card .card-title { font-weight: 600; }
      .link-card .card-sub { font-size: 0.8rem; color: var(--muted); margin-top: 0.15rem; }
      .tool-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
      .tool-link { display: inline-block; padding: 0.4rem 0.75rem; border: 1px solid var(--copper); border-radius: 2px; text-decoration: none; color: var(--copper); font-size: 0.85rem; font-weight: 500; transition: background 0.2s, color 0.2s; }
      .tool-link:hover { background: var(--copper); color: white; }

      @media (max-width: 600px) {
        .recipe-bar { gap: 0.5rem; }
        .link-grid { grid-template-columns: 1fr; }
        .bean-header h1 { font-size: 2rem; }
      }
    </style>
  </head>
  <body class="bg-cream">
    <Header />

    <main class="bean-page">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs">
        <a href="/">Home</a><span>/</span>
        <a href="/tools/brew-dial-in/">Brew Dial-In</a><span>/</span>
        {b.name}
      </nav>

      <!-- Bean Header -->
      <header class="bean-header">
        <div class="roaster-line">{b.roaster}</div>
        <h1>{b.name}</h1>
        <div class="bean-meta">
          {originDisplay && <span class="meta-tag"><a href={`/explore/origins/${b.origin}/`} style="color:inherit;text-decoration:none">{originDisplay}</a></span>}
          {roastDisplay && <span class="meta-tag">{roastDisplay} roast</span>}
          {b.processing && <span class="meta-tag">{b.processing}</span>}
          {varietyDisplay && <span class="meta-tag">{varietyDisplay}</span>}
        </div>
        {b.flavor_notes && b.flavor_notes.length > 0 && (
          <div class="flavor-tags">
            {b.flavor_notes.map((note) => <span class="flavor-tag">{note}</span>)}
          </div>
        )}
        <hr class="copper-rule" />
      </header>

      <!-- Narrative -->
      {(typeof bean.narrative === 'string' ? bean.narrative : bean.narrative?.text) && (
        <div class="narrative">
          {typeof bean.narrative === 'string' ? bean.narrative : bean.narrative?.text}
        </div>
      )}

      <!-- Brewer Sections (all 9, sorted by match score) -->
      {sortedBrewers.map((brewerId) => {
        const section = bean.brewer_content[brewerId];
        const isGated = section.gated;
        const recipe = section.recipe || {};
        const score = section.match_score;
        return (
          <article class={`brewer-section ${isGated ? 'gated' : ''}`} id={brewerId}>
            <div class="brewer-header">
              <span class="brewer-name">{BREWER_NAMES[brewerId] || brewerId}</span>
              {isGated ? (
                <span class="gated-badge">Flash Brew Recommended</span>
              ) : score ? (
                <span class="match-score">{score}/100</span>
              ) : null}
            </div>

            {!isGated && recipe.grind_um && (
              <div class="recipe-bar">
                <span class="recipe-param"><strong>Grind:</strong> {recipe.grind_um.start}μm</span>
                <span class="recipe-param"><strong>Temp:</strong> {recipe.temp_c.start}°C</span>
                <span class="recipe-param"><strong>Ratio:</strong> {recipe.ratio_display}</span>
                <span class="recipe-param"><strong>Time:</strong> {recipe.time_display}</span>
              </div>
            )}

            <p class="why-paragraph">{section.why_paragraph}</p>

            {section.troubleshooting && section.troubleshooting.length > 0 && !isGated && (
              <details class="troubleshooting">
                <summary>Troubleshooting</summary>
                {section.troubleshooting.map((t) => (
                  <div class="troubleshooting-item">
                    <span class="issue-label">{t.issue}:</span> {t.text}
                  </div>
                ))}
              </details>
            )}
          </article>
        );
      })}

      <!-- Internal Links -->
      <div class="links-section">
        <!-- Tool Links -->
        {bean.hub_links && bean.hub_links.length > 0 && (
          <div>
            <h2>Tools</h2>
            <hr class="section-rule" />
            <div class="tool-links">
              {bean.hub_links.map((link) => (
                <a href={link.url} class="tool-link">{link.title} →</a>
              ))}
            </div>
          </div>
        )}

        <!-- Similar Beans -->
        {bean.similar_beans && bean.similar_beans.length > 0 && (
          <div>
            <h2>Similar Coffees</h2>
            <hr class="section-rule" />
            <div class="link-grid">
              {bean.similar_beans.map((sim) => (
                <a href={`/tools/brew-dial-in/${sim.bean_id}/`} class="link-card">
                  <div class="card-label">{sim.roaster}</div>
                  <div class="card-title">{sim.name}</div>
                  <div class="card-sub">{(sim.origin || '').replace(/_/g, ' ')} · {sim.processing}</div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Same Roaster -->
        {bean.same_roaster && bean.same_roaster.length > 0 && (
          <div>
            <h2>More from {b.roaster}</h2>
            <hr class="section-rule" />
            <div class="link-grid">
              {bean.same_roaster.map((sr) => (
                <a href={`/tools/brew-dial-in/${sr.bean_id}/`} class="link-card">
                  <div class="card-title">{sr.name}</div>
                  <div class="card-sub">{(sr.origin || '').replace(/_/g, ' ')} · {sr.processing} · {sr.roast_level}</div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Blog Posts -->
        {bean.blog_links && bean.blog_links.length > 0 && (
          <div>
            <h2>Further Reading</h2>
            <hr class="section-rule" />
            <div class="link-grid">
              {bean.blog_links.map((blog) => (
                <a href={`/blog/${blog.slug}/`} class="link-card">
                  <div class="card-title">{blog.title}</div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>
