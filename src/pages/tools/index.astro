---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkshopScene from '../../components/WorkshopScene.svelte';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Coffee Toolkit — JayArr Coffee"
			description="Coffee tools that do the maths and show the reasoning: a brew guide with timed pours, a coffee doctor, grind and water guides, caffeine, freshness, drinks, machines and Nespresso pods."
		/>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "JayArr Coffee tools",
			"url": "https://jayarr.coffee/tools/",
			"description": "Coffee tools: brew guide, coffee doctor, extraction map, grind guide and calibrator, water recipes, caffeine, freshness, drinks, espresso machines and Nespresso pods.",
			"applicationCategory": "UtilityApplication",
			"operatingSystem": "Any",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"publisher": {
				"@type": "Organization",
				"name": "JayArr Coffee",
				"url": "https://jayarr.coffee"
			}
		})}></script>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-cream">
		<Header />

		<!-- Slim header strip -->
		<section class="bg-charcoal pt-28 pb-10">
			<div class="max-w-3xl mx-auto px-6 text-center">
				<span class="text-xs uppercase tracking-widest text-copper font-medium">Practical Tools</span>
				<h1 class="font-serif text-3xl md:text-5xl font-bold text-cream mt-2 mb-3">Your Coffee Toolkit</h1>
				<p class="text-cream/60 max-w-xl mx-auto text-sm leading-relaxed">
					Brew a better cup, fix a disappointing one, and choose the right gear. Every tool shows its reasoning and its sources.
				</p>
			</div>
		</section>

		<!-- Workshop scene -->
		<section class="py-8 md:py-12">
			<WorkshopScene client:load />
		</section>

		<Footer />
	</body>
</html>
