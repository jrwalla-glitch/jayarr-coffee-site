---
import BenchPage from '../../layouts/BenchPage.astro';
import ToolBench from '../../components/coffee/ToolBench.svelte';
import { TOOLS, TOOL_GROUPS } from '../../data/tools.ts';

const title = 'Coffee Tools: Brew Guide, Grind, Water, Caffeine and More';
const description = 'Every JayArr Coffee tool on one bench, grouped by the job: brew a cup, fix a bad one, check caffeine and freshness, choose a machine or pods, and explore origins and flavor.';
---

<BenchPage
  title={title}
  description={description}
  kicker="The toolkit"
  lede="Every tool draws what it works out, so you can see why the numbers come out as they do. Pick the job you're doing. Anything you've saved on this device waits just below."
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'JayArr Coffee tools',
    url: 'https://jayarr.coffee/tools/',
    description,
    hasPart: TOOLS.map((t) => ({ '@type': 'WebApplication', name: t.name, url: `https://jayarr.coffee${t.href}`, description: t.blurb, applicationCategory: t.group === 'explore' ? 'EducationalApplication' : 'UtilityApplication', operatingSystem: 'Any' })),
    publisher: { '@type': 'Organization', name: 'JayArr Coffee', url: 'https://jayarr.coffee' },
  }]}
>
  <Fragment slot="title">The coffee bench: <em>every tool, by the job</em></Fragment>
  <ToolBench client:load />

  <Fragment slot="body">
    <h2>How the tools fit together</h2>
    <p>Most cups start in the <a href="/tools/brew-ratio/">Brew Guide</a>: pick a brewer and a mug and it works out the coffee, the water, the temperature and every pour. The <a href="/tools/grind-guide/">Grind Guide</a> shows how fine to grind, and the <a href="/deep-brew/calibrator/">Grind Calibrator</a> turns that into a setting on your own grinder.</p>
    <p>If the cup comes out sour, bitter or weak, <a href="/tools/fix-my-coffee/">Fix My Coffee</a> asks a few questions and hands one change back to the Brew Guide. The <a href="/deep-brew/extraction/">Extraction Map</a> goes further, with a refractometer reading if you have one.</p>
    <p>The tools marked Deep Brew belong to the site's science section, <a href="/deep-brew/">Deep Brew</a>, where the research behind them lives.</p>
    <h2>Every tool</h2>
    {TOOL_GROUPS.map((g) => (
      <>
        <h3>{g.label}</h3>
        <ul>{TOOLS.filter((t) => t.group === g.id).map((t) => <li><a href={t.href}>{t.name}</a>: {t.blurb.charAt(0).toLowerCase() + t.blurb.slice(1)}.</li>)}</ul>
      </>
    ))}
  </Fragment>
</BenchPage>
