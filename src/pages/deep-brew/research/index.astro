---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { DB_CATEGORIES } from '../../../content.config';
import { TOOLS } from '../../../data/tools';

const title = 'Deep Brew Research: The Science Behind Better Coffee';
const description = 'Long-form explanations of coffee science, from extraction and espresso physics to roasting chemistry, aroma and climate, each linked to the tools that put it to use.';
const posts = (await getCollection('deepbrew')).sort((a, b) => a.data.title.localeCompare(b.data.title));
// The instruments in the landing page's order: water, extraction, grind.
const ORDER = ['/deep-brew/water', '/deep-brew/extraction', '/deep-brew/calibrator'];
const deepTools = TOOLS.filter((t) => t.deepBrew).sort((a, b) => ORDER.findIndex((o) => a.href.startsWith(o)) - ORDER.findIndex((o) => b.href.startsWith(o)));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="alternate" type="application/rss+xml" title="JayArr Coffee: Deep Brew research" href="/deep-brew/rss.xml" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: 'https://jayarr.coffee/deep-brew/research/',
			hasPart: posts.map((p) => ({ '@type': 'Article', headline: p.data.title, url: `https://jayarr.coffee/deep-brew/research/${p.id}/` })),
		})}></script>
	</head>
	<body class="cf-page db-dark">
		<Header />
		<main>
			<section class="cf-intro">
				<a href="/deep-brew/" class="cf-back">← Deep Brew</a>
				<p class="cf-kicker">Deep Brew · Research</p>
				<h1>The science behind <em>better coffee</em></h1>
				<p class="cf-lede">Ten long reads on what happens in the grinder, the brewer and the roaster, each with its sources. The three instruments below put the science to use. <a href="/deep-brew/rss.xml">Follow by RSS</a>.</p>
			</section>
			<section class="groups">
				{DB_CATEGORIES.map((cat) => {
					const list = posts.filter((p) => p.data.category === cat);
					return list.length > 0 && (
						<section class="group" aria-labelledby={`g-${cat}`}>
							<h2 id={`g-${cat}`}>{cat}</h2>
							<ul>
								{list.map((p) => (
									<li>
										<a href={`/deep-brew/research/${p.id}/`}>
											<span class="t">{p.data.title}</span>
											<span class="d">{p.data.description}</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					);
				})}
			</section>
			<section class="tools">
				<h2>Put it to use</h2>
				<ul>{deepTools.map((t) => <li><a href={t.href}><span class="t">{t.name}</span><span class="d">{t.blurb}</span></a></li>)}</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style is:global>.cf-page { background: var(--t-paper, #f3ede3); }</style>
<style>
	main { color: var(--t-ink, #2a1d15); font: 400 16px/1.5 'IBM Plex Sans', system-ui, sans-serif; }
	.cf-intro { max-width: 1180px; margin: 0 auto; padding: 120px 24px 18px; }
	.cf-back { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--t-ink-3, #75655a); text-decoration: none; }
	.cf-kicker { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--t-crema-deep, #8f5d22); margin: 26px 0 0; }
	h1 { font: 400 clamp(40px, 6vw, 68px)/.98 'Instrument Serif', Georgia, serif; margin: 10px 0 12px; }
	h1 em { font-style: italic; color: var(--t-coffee, #7a4e30); }
	.cf-lede { font-size: 17px; color: var(--t-ink-2, #5b4a3d); max-width: 62ch; margin: 0; }
	.cf-lede a { color: var(--t-crema-deep, #8f5d22); text-underline-offset: 3px; }
	.groups, .tools { max-width: 1180px; margin: 0 auto; padding: 8px 24px; }
	/* One row per note: the title on the left, what it covers on the right, so no field leaves a half-empty grid. */
	.group, .tools { margin-top: 26px; }
	h2 { font: 400 32px/1.1 'Instrument Serif', Georgia, serif; margin: 0; padding-top: 18px; border-top: 1px solid var(--t-rule, #d9cdbd); }
	ul { list-style: none; margin: 10px 0 0; padding: 0; }
	li a { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 4px 28px; align-items: baseline; padding: 14px 2px; border-bottom: 1px solid var(--t-rule-2, #e6dccd); text-decoration: none; color: inherit; }
	li:last-child a { border-bottom: 0; }
	li a:hover .t { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
	.t { font: 400 23px/1.15 'Instrument Serif', Georgia, serif; color: var(--t-ink, #2a1d15); }
	.d { font-size: 14.5px; line-height: 1.5; color: var(--t-ink-2, #5b4a3d); }
	.tools { padding-bottom: 80px; }
	a:focus-visible { outline: 2px solid var(--t-crema-deep, #8f5d22); outline-offset: 3px; border-radius: 3px; }
	@media (max-width: 760px) { li a { grid-template-columns: 1fr; } .cf-intro { padding: 96px 16px 14px; } .groups, .tools { padding: 8px 16px; } }
</style>
