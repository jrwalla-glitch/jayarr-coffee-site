---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DeepBrewPost from '../../../layouts/DeepBrewPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('deepbrew');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'deepbrew'>;

const post = Astro.props;
const { Content, headings } = await render(post);
// Reading time from the prose only (imports and component tags don't count).
const minutes = Math.max(1, Math.round((post.body ?? '').replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length / 230));
---

<DeepBrewPost {...post.data} id={post.id} headings={headings} minutes={minutes}>
	<Content />
</DeepBrewPost>
