---
import BenchPage from '../../../layouts/BenchPage.astro';
import OriginPlate from '../../../components/coffee/OriginPlate.astro';
import HarvestNow from '../../../components/coffee/HarvestNow.svelte';
import AltitudeBand from '../../../components/coffee/art/AltitudeBand.svelte';
import originHubs from '../../../data/origin-hubs.json';
import summaries from '../../../data/origin-summaries.json';
import originSources from '../../../data/origins-sources.json';
import { originByPage, harvestText, bandText, productionText, productionSource, sourceNames, ARRIVAL_EXAMPLES, ORIGINS } from '../../../lib/coffee/origins.ts';
import { notesInText, noteById, inSample } from '../../../lib/coffee/flavors.ts';

// The 19 country pages keep their indexed URLs (underscores included). Each is a detail plate
// from the Origins map: the country, its regions, its year, and the lots roasters described.
export function getStaticPaths() {
  return originHubs.map((hub) => ({ params: { origin: hub.origin_slug }, props: { hub } }));
}
const { hub } = Astro.props;
const o = originByPage(hub.origin_slug)!;
const summary = (summaries as Record<string, string>)[hub.origin_slug];
// The plain answer: its first sentence as the lead, the rest in body type.
const cut = summary.search(/(?<=[a-z)0-9]\.)\s+(?=[A-Z])/);
const [lead, rest] = cut > 0 ? [summary.slice(0, cut), summary.slice(cut).trim()] : [summary, ''];
const sources = originSources as Record<string, { title: string; url: string; checked: string }>;
const arrival = ARRIVAL_EXAMPLES.find((a) => a.origin === o.name);

const url = `https://jayarr.coffee/explore/origins/${hub.origin_slug}/`;
const title = `${o.name} Coffee: Harvest Season, Growing Regions and Flavor`;
const description = `${o.name} coffee at a glance: when it's harvested (${harvestText(o)}), where and how high it grows, how much is produced, and how its coffees are described, with sources.`;

// Roasters' words for this origin's lots, and the lots themselves (as the roasters described them).
const counts = new Map<string, number>();
const sample = hub.beans.filter((b) => inSample(b.name, b.flavor_notes));
for (const b of sample) for (const n of new Set(b.flavor_notes.flatMap((t) => notesInText(t, { roaster: true })))) counts.set(n, (counts.get(n) ?? 0) + 1);
const words = [...counts.entries()].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([id, n]) => ({ id, label: noteById(id)!.label, n }));
const PROC: Record<string, string> = { washed: 'Washed', natural: 'Natural', honey: 'Honey', honey_white: 'White honey', honey_red: 'Red honey', anaerobic_washed: 'Anaerobic washed', anaerobic_natural: 'Anaerobic natural', 'semi-washed': 'Semi-washed', washed_ea_decaf: 'Washed, EA decaf', blend_washed_natural: 'Washed and natural blend', natural_and_washed_blend: 'Washed and natural blend' };
const ROAST: Record<string, string> = { light: 'Light', medium_light: 'Medium-light', medium: 'Medium', medium_dark: 'Medium-dark', dark: 'Dark' };
const titleCase = (s: string) => (s === s.toUpperCase() ? s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase()) : s);
// The roasters' own words, tidied of scraping leftovers ("amp;", sentence fragments); none listed shows a dash.
const cleanNote = (n: string) => n.replace(/&amp;|\bamp;/g, '&').replace(/^[&\s]+/, '').trim();
const fragment = (n: string) => n.length >= 40 || /^(and|as well as|leading|sometimes|indulgent)\b|nbsp/i.test(n);
const lots = hub.beans.map((b) => ({ roaster: b.roaster, name: titleCase(b.name), process: PROC[b.processing] ?? b.processing, roast: ROAST[b.roast_level] ?? b.roast_level, notes: b.flavor_notes.map(cleanNote).filter((n) => n && !fragment(n)).join(', ') || '—' }));

const sourceIds = [...new Set([...o.harvest.sources, ...(o.altitudeM?.sources ?? []), ...(o.robustaAltitudeM?.sources ?? []), ...(o.production ? [o.production.source] : []), o.tendencies.source, ...(o.sources?.varieties ?? []), ...(o.sources?.processing ?? []), ...(o.sources?.regions ?? [])])].filter((id) => sources[id]);
// The closest other country pages, by distance on the globe (not just the same continent tab).
const km = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
  const r = Math.PI / 180, h = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lon - a.lon) * r) / 2) ** 2;
  return 12742 * Math.asin(Math.sqrt(h));
};
const neighbours = ORIGINS.filter((x) => x.id !== o.id && x.page).sort((a, b) => km(o, a) - km(o, b)).slice(0, 4);
---

<BenchPage
  title={title}
  description={description}
  kicker="Country profile"
  back={{ href: '/explore/origins/', label: 'The Coffee Origins' }}
  gallery
  breadcrumbs={false}
  schema={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url, publisher: { '@type': 'Organization', name: 'JayArr Coffee', url: 'https://jayarr.coffee' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jayarr.coffee/' },
      { '@type': 'ListItem', position: 2, name: 'Explore', item: 'https://jayarr.coffee/explore/' },
      { '@type': 'ListItem', position: 3, name: 'The Coffee Origins', item: 'https://jayarr.coffee/explore/origins/' },
      { '@type': 'ListItem', position: 4, name: o.name, item: url },
    ] },
  ]}
>
  <Fragment slot="title">{`${o.name} `}<em>coffee</em></Fragment>
  <Fragment slot="intro"><div class="op-answer"><p class="op-lead">{lead}</p>{rest && <p class="op-rest">{rest}</p>}</div></Fragment>

  <div class="op">

    <figure class="op-plate">
      <div class="gp-frame" style="--mat: #e8e1d4; --matpad: 12px; --matpad-phone: 7px">
        <OriginPlate origin={o} />
      </div>
      <figcaption class="gp-plaque"><b>{o.name}</b><small>A detail from The Coffee Origins</small></figcaption>
    </figure>

    <section class="gp-label op-label" aria-labelledby="op-glance">
      <h2 id="op-glance">At a glance</h2>
      <div class="op-pair">
        <HarvestNow client:load harvest={o.harvest} name={o.name} size={150} />
        <AltitudeBand arabica={o.altitudeM} robusta={o.robustaAltitudeM} name={o.name} height={160} />
      </div>
      <dl class="op-facts">
        <div><dt>Harvest</dt><dd>{harvestText(o)}{o.harvest.variesBy && <span class="sub">{o.harvest.variesBy}</span>}{arrival && <span class="sub">Typical arrival in the US: {arrival.arrival} (Café Imports).</span>}{o.harvest.sources.length > 0 && <span class="sub">Calendar from {sourceNames(o.harvest.sources)}, checked October 2026. Other references can differ by a month or so.</span>}</dd></div>
        <div><dt>Altitude</dt><dd>{o.altitudeM ? bandText(o.altitudeM) : 'Not established'}{o.robustaAltitudeM && <span class="sub">Robusta: {bandText(o.robustaAltitudeM)}{o.robustaAltitudeM.sources?.length ? ` (${sourceNames(o.robustaAltitudeM.sources)})` : ''}</span>}{o.altitudeM?.scope && <span class="sub">{o.altitudeM.scope.replace(/;?\s*not national extrema\.?/i, "; not the country's highest or lowest farms.")}</span>}{o.altitudeM?.sources?.length ? <span class="sub">Band from {sourceNames(o.altitudeM.sources)}.</span> : null}</dd></div>
        <div><dt>Production</dt><dd>{productionText(o) ?? 'No current official figure'}{o.production && <span class="sub">{productionSource(o)}.</span>}</dd></div>
        <div><dt>Varieties</dt><dd>{o.varieties.join(', ')}</dd></div>
        <div><dt>Processing</dt><dd>{o.processing.join(', ')}</dd></div>
        <div><dt>Regions</dt><dd>{o.regions.map((r) => r.name).join(', ')}</dd></div>
        <div><dt>Often described as</dt><dd><em class="op-notes">{o.tendencies.notes.join(', ')}</em></dd></div>
      </dl>
      <p class="op-map"><a href={`/explore/origins/?o=${o.id}`}>See {o.name} on the map, and compare it →</a></p>
    </section>

  </div>

  <Fragment slot="body">
    <h2>How its coffees are described</h2>
    <p>Importers usually describe {o.name}'s coffees as <em class="op-notes">{o.tendencies.notes.join(', ')}</em>. {o.tendencies.caveat} These are tendencies, not a promise about a particular bag.</p>

    {words.length > 0 && (
      <>
        <h2>Roasters' words</h2>
        <p>Across {sample.length} described single-origin lots from {o.name} in 38 specialty roasters' catalogs (recorded January–March 2026), these are the notes roasters used most. Each opens in the <a href="/explore/flavors/">Flavor Bloom</a> with an exercise to train your nose on it.</p>
        <ul class="op-words">{words.map((w) => <li><a href={`/explore/flavors/?note=${w.id}`}>{w.label}</a> <span>{w.n} lots</span></li>)}</ul>
      </>
    )}

    <details class="op-lots">
      <summary>All {lots.length} lots, as roasters described them (winter 2026){sample.length < lots.length && <span class="op-sumnote"> · {sample.length} single-origin lots with tasting notes are counted above</span>}</summary>
      <p class="bp-note">Lots are seasonal: this is a record of how roasters described these coffees in early 2026, not a list of what's in stock.</p>
      <div class="op-tab-wrap">
        <table class="op-tab">
          <thead><tr><th scope="col">Lot</th><th scope="col">Roaster</th><th scope="col">Process</th><th scope="col">Roast</th><th scope="col">Roaster's notes</th></tr></thead>
          <tbody>{lots.map((l) => <tr><th scope="row">{l.name}</th><td>{l.roaster}</td><td>{l.process}</td><td>{l.roast}</td><td>{l.notes}</td></tr>)}</tbody>
        </table>
      </div>
    </details>

    {o.articles.length > 0 && (
      <>
        <h2>Read more</h2>
        <ul>{o.articles.map((a) => <li><a href={`/blog/${a.slug}/`}>{a.title}</a></li>)}</ul>
      </>
    )}

    <h2>Brew it</h2>
    <p>Single origins show their character best brewed clean. The <a href="/tools/brew-ratio/?method=v60&cup=354.9">Brew Guide</a> starts you on a V60; if the cup comes out sour or bitter, <a href="/tools/fix-my-coffee/">Fix My Coffee</a> finds the one change to make. <a href="/explore/methods/">Brewing Constellations</a> shows how other brewers change the cup.</p>

    {neighbours.length > 0 && (
      <>
        <h2>The nearest country pages</h2>
        <p>{neighbours.map((n, i) => <>{i > 0 && ' · '}<a href={n.page}>{n.name}</a></>)}</p>
      </>
    )}

    <h2>Sources</h2>
    <ul class="bp-sources">
      {sourceIds.map((id) => <li><a href={sources[id].url} rel="noopener">{sources[id].title}</a>, checked {sources[id].checked}.</li>)}
    </ul>
  </Fragment>
</BenchPage>

<style>
  /* Plate, then label, in document order on every screen, so nothing moves as the page streams in. */
  .op { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .op-plate { margin: 0; position: sticky; top: 84px; }
  .op-sumnote { font-weight: 400; color: #75655a; }
  .op-label h2 { font: 400 30px/1.1 'Instrument Serif', 'Instrument Serif Fallback', Georgia, serif; margin: 0 0 6px; }
  .op-pair { display: flex; gap: 10px; align-items: center; justify-content: center; margin: 6px 0 10px; }
  .op-facts { margin: 0; border-top: 1px solid #d9cdbd; font: 400 15px/1.45 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .op-facts div { display: grid; grid-template-columns: 112px 1fr; gap: 10px; padding: 7px 0; border-bottom: 1px solid #d9cdbd; }
  .op-facts dt { font: 500 11px 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; padding-top: 2px; }
  .op-facts dd { margin: 0; color: #2a1d15; }
  .op-facts .sub { display: block; font-size: 13.5px; color: #75655a; margin-top: 2px; }
  .op-map { margin: 12px 0 0; font: 600 15px 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; }
  .op-map a { color: #7a4e30; text-underline-offset: 3px; }
  .op-answer { max-width: 60ch; margin: 6px auto 0; text-align: center; }
  .op-lead { font: 400 25px/1.3 'Instrument Serif', 'Instrument Serif Fallback', Georgia, serif; color: #2a1d15; margin: 0 0 8px; text-wrap: balance; }
  .op-rest { font: 400 16.5px/1.55 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; color: #5b4a3d; margin: 0; text-wrap: pretty; }
  .op-notes { font-family: 'Instrument Serif', 'Instrument Serif Fallback', Georgia, serif; font-size: 1.15em; }
  .op-words { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .op-words li { border: 1px solid #d9cdbd; background: #fbf8f3; border-radius: 999px; padding: 5px 12px; margin: 0; }
  .op-words span { font: 500 12px 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; color: #75655a; margin-left: 4px; }
  .op-lots { margin: 26px 0; }
  .op-lots summary { cursor: pointer; font-weight: 600; }
  .op-tab-wrap { overflow-x: auto; border: 1px solid #d9cdbd; border-radius: 4px; background: #fbf8f3; }
  .op-tab { width: 100%; border-collapse: collapse; font-size: 14px; }
  .op-tab th, .op-tab td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #e6dccd; vertical-align: top; }
  .op-tab thead th { font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; white-space: nowrap; }
  .op-tab tbody th { font-weight: 600; }
  @media (max-width: 900px) { .op { grid-template-columns: 1fr; gap: 22px; } .op-plate { position: static; } }
  @media (max-width: 640px) { .op-answer { text-align: left; } .op-lead { font-size: 21px; } .op-rest { font-size: 15.5px; } }
</style>
