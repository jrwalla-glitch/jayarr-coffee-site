---
import BenchPage from '../../../layouts/BenchPage.astro';
import OriginAtlas from '../../../components/coffee/OriginAtlas.svelte';
import originHubs from '../../../data/origin-hubs.json';
import originSources from '../../../data/origins-sources.json';
import { ORIGINS, CONTINENTS, harvestText, bandText, productionText } from '../../../lib/coffee/origins.ts';
import { notesInText, noteById, inSample } from '../../../lib/coffee/flavors.ts';

const title = 'Coffee Origins Map: Harvest Seasons, Altitude and Flavor';
const description = 'A map of 30 coffee origins: when each is harvested, how high it grows, how much it produces and how its coffees are described, with sources. Compare any two.';

// Roasters' most-used words per origin, from the winter 2026 catalog sample (the Flavor Bloom's data).
const roasterWords: Record<string, { words: { id: string; label: string; n: number }[]; lots: number }> = {};
for (const h of originHubs) {
  const id = h.origin_slug.replace(/_/g, '-');
  const counts = new Map<string, number>();
  const sample = h.beans.filter((b) => inSample(b.name, b.flavor_notes));
  for (const b of sample) for (const n of new Set(b.flavor_notes.flatMap((t) => notesInText(t, { roaster: true })))) counts.set(n, (counts.get(n) ?? 0) + 1);
  const words = [...counts.entries()].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([nid, n]) => ({ id: nid, label: noteById(nid)!.label, n }));
  roasterWords[id] = { words, lots: sample.length };
}
const sources = originSources as Record<string, { title: string; url: string; checked: string }>;
const sourceList = Object.entries(sources).sort((a, b) => a[1].title.localeCompare(b[1].title));
---

<BenchPage
  title={title}
  description={description}
  kicker="Explore · The Coffee Origins"
  lede="Thirty origins: who's harvesting now, where it grows and how it's described."
  back={{ href: '/explore/', label: 'The gallery' }}
  gallery
  wide
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'The Coffee Origins',
    url: 'https://jayarr.coffee/explore/origins/',
    description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'JayArr Coffee', url: 'https://jayarr.coffee' },
  }]}
>
  <Fragment slot="title">The Coffee Origins: <em>where and when it grows</em></Fragment>
  <OriginAtlas client:load roasterWords={roasterWords} sources={sources} />
  <noscript><p class="bp-noscript">The interactive map needs JavaScript. Every origin is listed in the table below.</p></noscript>

  <Fragment slot="body">
    <h2>How to read the map</h2>
    <p>Each origin's year is a ring, January at the top and running clockwise. Solid copper marks the main harvest, a paler arc a second crop where the sources give one (Colombia's mitaca, Kenya's fly crop), and hatching a month or two either side of each harvest. The hatching is a buffer, not a month any source gives: picking can start early or run late with altitude, region and the year's weather. Turn the month to light up every origin picking at that time.</p>
    <p>Harvest isn't when coffee reaches your roaster. Cherries are processed, dried, rested, milled and shipped first, and importers list arrival separately: Café Imports gives Ethiopia's October–January harvest an April–June arrival in the US. There's no single lag that fits every origin.</p>
    <p>Altitude is drawn on one scale, from sea level to 2,600 m, for the coffees each source describes, not the country's highest and lowest farms. Where robusta is at least a fifth of production, its band is shown hatched beside arabica's; Brazil is the exception, because no source gives a general band for its conilon.</p>
    <p>"Often described as" is how importers describe each origin's coffees in general. It's a tendency, not a promise about a bag, and the processing often matters more than the country: a natural Ethiopian and a washed one can taste very different. The <a href="/explore/flavors/">Flavor Bloom</a> shows which words roasters use for which origins.</p>

    <h2>Every origin</h2>
    {CONTINENTS.map((c) => (
      <>
        <h3>{c.label}</h3>
        <div class="otab-wrap">
          <table class="otab">
            <thead><tr><th scope="col">Origin</th><th scope="col">Harvest</th><th scope="col">Altitude (arabica)</th><th scope="col">Production</th></tr></thead>
            <tbody>
              {ORIGINS.filter((o) => o.continent === c.id).map((o) => (
                <tr>
                  <th scope="row">{o.page ? <a href={o.page}>{o.name}</a> : o.name}</th>
                  <td>{harvestText(o)}</td>
                  <td class="mono">{o.altitudeM ? bandText(o.altitudeM).replace(/ \(.*\)$/, '') : '—'}</td>
                  <td class="mono">{productionText(o) ?? 'No current figure'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))}
    <p class="bp-note">Production is in 60 kg bags of green coffee, from the US Department of Agriculture's Foreign Agricultural Service (PSD, July 2026) unless noted; forecasts are for the 2026/27 season. Hawaii's figure is calculated from the USDA's Hawaii coffee report. Harvest calendars are importers' (mostly Café Imports and Sucafina); other references, such as atlases and national boards, can differ by a month or so, so each country's page names the source of every figure. Research checked 15 October 2026.</p>

    <h2>Sources</h2>
    <details>
      <summary>{sourceList.length} sources, each checked 15 October 2026</summary>
      <ul class="bp-sources">
        {sourceList.map(([, s]) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
      </ul>
    </details>
  </Fragment>
</BenchPage>

<style>
  .otab-wrap { overflow-x: auto; border: 1px solid #d9cdbd; border-radius: 4px; background: #fbf8f3; margin-bottom: 8px; }
  .otab { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .otab th, .otab td { text-align: left; padding: 8px 12px; border-bottom: 1px solid #e6dccd; }
  .otab thead th { font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; }
  .otab tbody th { font-weight: 600; white-space: nowrap; }
  .otab .mono { font-family: 'IBM Plex Mono', 'IBM Plex Mono Fallback', monospace; font-size: 13px; white-space: nowrap; }
  .otab tr:last-child th, .otab tr:last-child td { border-bottom: 0; }
</style>
