---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import HomeStart from '../components/coffee/HomeStart.svelte';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const description = 'Brew a better cup at home: tools that draw what they work out, guides that show their sources, and a gallery of where coffee grows, how it\'s brewed and how it tastes.';
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const bySlug = (slug: string) => allPosts.find((p) => p.id === slug);
const latest = allPosts.slice(0, 6);

// Start here: one guide per everyday job, each opening its tool from the page.
const START = [
  { slug: 'ultimate-pour-over-coffee-guide-and-best-v60-technique', job: 'Pour-over' },
  { slug: 'how-to-dial-in-espresso', job: 'Espresso' },
  { slug: 'cold-brew-concentrate-guide', job: 'Cold brew' },
  { slug: 'why-water-matters-more-than-your-coffee-beans', job: 'Water' },
].map((x) => ({ ...x, post: bySlug(x.slug) })).filter((x) => x.post);
// From the channel: the original reviews and comparisons the site grew out of.
const REVIEWS = ['peets-vs-starbucks-comparison-and-coffee-review', '7-ethiopian-coffees-reviewed-best-and-worst', 'espresso-battle-royale-reviews-of-gaggia-breville-bambino-and-phillips-3200', 'cold-brewing-coffee-with-the-coffeesock']
  .map(bySlug).filter((p): p is NonNullable<typeof p> => !!p);
const featured = bySlug('coffee-grind-size-guide-what-grind-for-every-brew-method');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={description} />
    <link rel="preload" as="image" href="/hero/espresso-hero-poster.jpg" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_TITLE,
      url: 'https://jayarr.coffee',
      description,
      publisher: { '@type': 'Organization', name: SITE_TITLE, url: 'https://jayarr.coffee', logo: { '@type': 'ImageObject', url: 'https://jayarr.coffee/favicon.svg' } },
    })} />
  </head>
  <body class="home">
    <Header />
    <main id="main">
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <img src="/hero/espresso-hero-poster.jpg" alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
          <video class="hero-video" muted loop playsinline preload="none" poster="/hero/espresso-hero-poster.jpg" data-webm="/hero/espresso-hero.webm" data-mp4="/hero/espresso-hero.mp4"></video>
        </div>
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="kicker">JayArr Coffee</p>
            <h1>Better coffee at home, <em>with the working shown</em></h1>
            <p class="lede">Tools that draw what they calculate, guides that show their sources, and a small gallery of where coffee grows, how it's brewed and how it tastes.</p>
            <p class="more"><a href="/tools/">Every tool →</a> <a href="/explore/">The gallery →</a> <a href="/deep-brew/">Deep Brew →</a></p>
          </div>
          <div class="hero-card">
            <HomeStart client:load />
          </div>
        </div>
      </section>

      <section class="band paths" aria-labelledby="start-h">
        <div class="wrap">
          <p class="eyebrow">Start here</p>
          <h2 id="start-h">One guide for each everyday job</h2>
          <ul class="cards">
            {START.map(({ post, job }) => (
              <li>
                <a href={`/blog/${post!.id}/`} class="card">
                  {post!.data.heroImage && (
                    <span class="img"><Image src={post!.data.heroImage} alt="" widths={[360, 540, 720]} sizes="(min-width: 1100px) 260px, (min-width: 640px) 45vw, 100vw" loading="lazy" /></span>
                  )}
                  <span class="job">{job}</span>
                  <span class="t">{post!.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="band channel" aria-labelledby="channel-h">
        <div class="wrap two">
          <div>
            <p class="eyebrow">From the channel</p>
            <h2 id="channel-h">Where the site began</h2>
            <p>JayArr Coffee started as a YouTube channel in 2019: reviews, side-by-side comparisons and brewing technique. The videos still sit inside the guides they belong to.</p>
            <ul class="reviews">
              {REVIEWS.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
            </ul>
            <p><a class="arrow" href="/videos/">Every video →</a></p>
          </div>
          {featured && (
            <div class="video">
              <LiteYouTube videoId="JT01fu8P_LM" title={featured.data.title} />
              <p class="vcap"><a href={`/blog/${featured.id}/`}>{featured.data.title}</a>, with the <a href="/tools/grind-guide/">Grind Guide</a> beside it.</p>
            </div>
          )}
        </div>
      </section>

      <section class="band deep" aria-labelledby="deep-h">
        <div class="wrap two">
          <div>
            <p class="eyebrow">Deep Brew</p>
            <h2 id="deep-h">The science section</h2>
            <p>For when you want the measurements: mixing brewing water to a recipe, reading extraction from a refractometer, and setting your own grinder, with ten long-form research articles behind them.</p>
          </div>
          <ul class="deeplinks">
            <li><a href="/deep-brew/water/"><b>Water Recipe Builder</b><span>Mix brewing water to a recipe</span></a></li>
            <li><a href="/deep-brew/extraction/"><b>Extraction Map</b><span>Where your cup sits between sour and bitter</span></a></li>
            <li><a href="/deep-brew/calibrator/"><b>Grind Calibrator</b><span>The number to set on your grinder</span></a></li>
            <li><a href="/deep-brew/research/"><b>The research</b><span>Ten long-form articles</span></a></li>
          </ul>
        </div>
      </section>

      <section class="band latest" aria-labelledby="latest-h">
        <div class="wrap">
          <p class="eyebrow">Latest</p>
          <h2 id="latest-h">New and updated articles</h2>
          <ul class="list">
            {latest.map((p) => (
              <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="date"><FormattedDate date={p.data.pubDate} /></span></li>
            ))}
          </ul>
          <p><a class="arrow" href="/blog/">All articles →</a></p>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      // The hero video only loads after the page is ready, on wide screens, and never when the
      // reader prefers reduced motion or saves data. Everyone else keeps the still poster.
      const v = document.querySelector<HTMLVideoElement>('.hero-video');
      const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
      const ok = v && innerWidth >= 900 && !matchMedia('(prefers-reduced-motion: reduce)').matches && !nav.connection?.saveData;
      if (ok && v) {
        const start = () => {
          for (const [type, key] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
            const s = document.createElement('source'); s.type = type; s.src = v.dataset[key]!; v.appendChild(s);
          }
          v.load();
          v.addEventListener('canplay', () => { v.classList.add('on'); v.play().catch(() => {}); }, { once: true });
        };
        const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
        addEventListener('load', () => (idle ? idle(start) : setTimeout(start, 1200)), { once: true });
      }
    </script>
  </body>
</html>

<style is:global>
  body.home { background: #f3ede3; }
</style>
<style>
  main { color: #2a1d15; }
  .hero { position: relative; overflow: hidden; background: #1f1610; color: #f3ede3; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img, .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-video { opacity: 0; transition: opacity 1s ease; }
  .hero-video.on { opacity: 1; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(20, 14, 10, .9) 0%, rgba(20, 14, 10, .78) 42%, rgba(20, 14, 10, .5) 100%), linear-gradient(180deg, rgba(20, 14, 10, .3), rgba(20, 14, 10, .65)); }
  .hero-inner { position: relative; max-width: 1240px; margin: 0 auto; padding: 120px 24px 56px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: 40px; align-items: center; min-height: 640px; }
  .kicker { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .16em; text-transform: uppercase; color: #d9a35e; margin: 0 0 14px; }
  .hero h1 { font: 400 clamp(42px, 5.6vw, 70px)/1 'Instrument Serif', Georgia, serif; margin: 0 0 16px; letter-spacing: -.01em; color: #fbf6ee; }
  .hero h1 em { color: #e2b47a; }
  .lede { font: 400 18px/1.55 'IBM Plex Sans', sans-serif; color: rgba(243, 237, 227, .86); max-width: 46ch; margin: 0 0 18px; }
  .more { display: flex; gap: 8px 20px; flex-wrap: wrap; margin: 0; }
  .more a { color: #f3ede3; font: 500 15px 'IBM Plex Sans', sans-serif; text-decoration: underline; text-decoration-color: rgba(217, 163, 94, .7); text-underline-offset: 4px; }
  .more a:hover { color: #fff; }
  .band { padding: 56px 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; align-items: center; }
  .eyebrow { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 0 0 8px; }
  .band h2 { font: 400 clamp(32px, 4vw, 44px)/1.05 'Instrument Serif', Georgia, serif; margin: 0 0 14px; }
  .band p { font-size: 16.5px; line-height: 1.6; color: #5b4a3d; max-width: 60ch; }
  .cards { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .card { display: grid; gap: 6px; text-decoration: none; color: #2a1d15; }
  .card .img { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 12px; background: #e6dccd; }
  .card .img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .img :global(img) { transform: scale(1.03); }
  .job { font: 500 11px 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #8f5d22; margin-top: 6px; }
  .card .t { font: 400 22px/1.15 'Instrument Serif', Georgia, serif; }
  .channel { background: #fbf8f3; border-top: 1px solid #e6dccd; border-bottom: 1px solid #e6dccd; }
  .reviews { list-style: none; padding: 0; margin: 12px 0; display: grid; gap: 8px; }
  .reviews a { color: #2a1d15; font: 500 16px 'IBM Plex Sans', sans-serif; text-decoration: underline; text-decoration-color: #c9a46e; text-underline-offset: 3px; }
  .arrow { color: #7a4e30; font-weight: 600; text-underline-offset: 3px; }
  .video :global(.lite-youtube), .video :global(lite-youtube) { border-radius: 12px; overflow: hidden; }
  .vcap { font-size: 14.5px !important; margin-top: 8px; }
  .vcap a { color: #7a4e30; }
  .deep { background: #1d1713; color: #efe6da; }
  .deep .eyebrow { color: #e0a85a; }
  .deep p { color: #c8b9a8; }
  .deeplinks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .deeplinks a { display: grid; gap: 2px; border: 1px solid #3a2f27; background: #241c17; border-radius: 12px; padding: 14px 16px; text-decoration: none; color: #efe6da; }
  .deeplinks a:hover { border-color: #e0a85a; }
  .deeplinks b { font: 400 22px/1.1 'Instrument Serif', Georgia, serif; font-weight: 400; }
  .deeplinks span { font-size: 14px; color: #c8b9a8; }
  .list { list-style: none; padding: 0; margin: 10px 0 14px; columns: 2; column-gap: 40px; }
  .list li { break-inside: avoid; padding: 9px 0; border-bottom: 1px solid #e6dccd; }
  .list a { color: #2a1d15; font: 500 16px 'IBM Plex Sans', sans-serif; text-decoration: none; }
  .list a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .date { display: block; font: 500 12px 'IBM Plex Mono', monospace; color: #75655a; margin-top: 2px; }
  a:focus-visible { outline: 3px solid #d9a35e; outline-offset: 3px; border-radius: 4px; }
  @media (max-width: 1000px) {
    .hero-inner { grid-template-columns: 1fr; padding: 100px 20px 36px; min-height: 0; gap: 22px; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .two { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 640px) {
    .hero-inner { padding: 88px 14px 28px; }
    .lede { font-size: 16.5px; margin-bottom: 12px; }
    .band { padding: 40px 0; }
    .wrap { padding: 0 16px; }
    .cards { grid-template-columns: 1fr 1fr; gap: 12px; }
    .card .t { font-size: 18px; }
    .deeplinks { grid-template-columns: 1fr; }
    .list { columns: 1; }
  }
</style>
