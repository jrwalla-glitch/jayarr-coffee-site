---
// The page shell for Explore and the tool hub: the same intro, card and article rhythm as the
// rebuilt tool pages, so every bench page reads as one site. One H1, from the `title` slot.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
  lede?: string;
  back?: { href: string; label: string };
  /** JSON-LD objects for this page (the layout adds nothing of its own beyond BaseHead's breadcrumbs). */
  schema?: object[];
  /** Pages that print their own BreadcrumbList pass false. */
  breadcrumbs?: boolean;
  /** Wider stage for map-like tools. */
  wide?: boolean;
  /** Explore pieces hang in the gallery (DECISIONS #16): centred title, gallery wall and lighting. */
  gallery?: boolean;
}
const { title, description, kicker, lede, back, schema = [], breadcrumbs = true, wide = false, gallery = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} breadcrumbs={breadcrumbs} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class:list={['bp-page', gallery && 'bp-gallery']}>
    <Header />
    <main id="main">
      <section class:list={['bp-intro', wide && 'wide']}>
        {back && <a href={back.href} class="bp-back">← {back.label}</a>}
        <p class="bp-kicker">{kicker}</p>
        <h1><slot name="title" /></h1>
        {lede && <p class="bp-lede">{lede}</p>}
        <slot name="intro" />
      </section>
      <section class:list={['bp-tool', wide && 'wide']}>
        <slot />
      </section>
      <slot name="after" />
      {Astro.slots.has('body') && <article class="bp-body"><slot name="body" /></article>}
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .bp-page { background: #f3ede3; }
  .bp-page main { color: #2a1d15; }
  .bp-intro { max-width: 1180px; margin: 0 auto; padding: 116px 24px 20px; }
  .bp-intro.wide, .bp-tool.wide { max-width: 1320px; }
  .bp-back { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #75655a; text-decoration: none; }
  .bp-back:hover { color: #8f5d22; }
  .bp-kicker { font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 24px 0 0; }
  .bp-intro h1 { font: 400 clamp(40px, 6vw, 68px)/.98 'Instrument Serif', Georgia, serif; letter-spacing: -.01em; margin: 10px 0 12px; color: #2a1d15; }
  .bp-intro h1 em { font-style: italic; color: #7a4e30; }
  .bp-lede { font: 400 17px/1.5 'IBM Plex Sans', system-ui, sans-serif; color: #5b4a3d; max-width: 62ch; margin: 0; }
  .bp-tool { max-width: 1180px; margin: 0 auto; padding: 8px 24px 40px; }
  .bp-body { max-width: 760px; margin: 0 auto; padding: 24px 24px 72px; font: 400 17px/1.7 'IBM Plex Sans', system-ui, sans-serif; color: #2a1d15; }
  .bp-body h2 { font: 400 34px/1.1 'Instrument Serif', Georgia, serif; margin: 44px 0 12px; letter-spacing: 0; }
  .bp-body h3 { font: 600 17px/1.3 'IBM Plex Sans', sans-serif; margin: 26px 0 6px; }
  .bp-body a { color: #7a4e30; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bp-body a:hover { color: #8f5d22; }
  .bp-body ul { padding-left: 1.2em; }
  .bp-body li { margin: 4px 0; }
  .bp-body .bp-sources { font-size: 14.5px; color: #5b4a3d; }
  .bp-body .bp-note { font-size: 15px; color: #5b4a3d; }
  .bp-noscript { font: 400 15px/1.5 'IBM Plex Sans', sans-serif; background: #fbf8f3; border: 1px solid #d9cdbd; border-radius: 12px; padding: 12px 16px; }
  /* ── The gallery (Explore): the wall, the frames, the brass plaques, the wall labels ── */
  .bp-gallery { background: #f2ebe0; }
  .bp-gallery main { background: radial-gradient(1200px 520px at 50% 330px, rgba(255, 248, 232, .85), rgba(255, 248, 232, 0) 70%); }
  .bp-gallery .bp-intro { text-align: center; }
  .bp-gallery .bp-intro .bp-lede { margin: 0 auto; font-style: italic; color: #6b5d50; }
  .bp-gallery .bp-intro .bp-back { display: inline-block; }
  .gp-frame {
    position: relative; background: var(--mat, #e8e1d4); border: 3px solid #2a2520; border-radius: 2px; padding: var(--matpad, 14px);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, .09), inset 0 -2px 6px rgba(0, 0, 0, .05), inset 3px 0 8px rgba(0, 0, 0, .06), inset -3px 0 8px rgba(0, 0, 0, .06),
      0 22px 44px -26px rgba(42, 29, 21, .55), 0 2px 8px rgba(0, 0, 0, .06);
  }
  .gp-frame::after { content: ''; position: absolute; inset: 3px; border: 1px solid rgba(193, 122, 58, .6); border-radius: 1px; pointer-events: none; }
  .gp-frame::before { content: ''; position: absolute; inset: 6px; border: .6px solid #6b5d4e; border-radius: 1px; pointer-events: none; opacity: .7; }
  .gp-plaque {
    display: table; margin: 14px auto 0; background: linear-gradient(180deg, #c5a55a 0%, #b8963e 50%, #a8893e 100%);
    padding: 7px 22px 6px; border-radius: 2px; text-align: center; border: .5px solid #8b7530;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255, 255, 255, .25);
  }
  .gp-plaque b { display: block; font: 400 19px/1.25 'Instrument Serif', Georgia, serif; color: #2a2520; letter-spacing: .01em; }
  .gp-plaque small { display: block; font: 500 10.5px/1.4 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #4a3f2f; opacity: .85; }
  .gp-label { background: #fbf8f3; border: 1px solid #dccfbd; border-radius: 3px; box-shadow: 0 12px 30px -24px rgba(42, 29, 21, .5); padding: 18px 20px; }
  @media (max-width: 640px) {
    .gp-frame { padding: var(--matpad-phone, 8px); border-width: 2px; }
    .gp-plaque { padding: 6px 16px 5px; }
    .gp-plaque b { font-size: 17px; }
    .gp-label { padding: 14px 14px; }
  }
  @media (max-width: 640px) {
    .bp-intro { padding: 92px 16px 16px; }
    .bp-tool { padding: 4px 12px 32px; }
    .bp-body { padding: 16px 16px 56px; }
  }
</style>
