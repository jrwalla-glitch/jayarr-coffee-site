---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, pubDate, updatedDate, heroImage, category, id, videoId, videoDate } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const site = Astro.site?.toString() ?? 'https://jayarr.coffee/';
// Frontmatter dates parse to local midnight; emit the calendar day so builds agree everywhere.
const day = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const isVideoEra = pubDate.getFullYear() < 2026;
const categoryUrl = category ? new URL(`/blog/category/${category.toLowerCase()}/`, Astro.site).toString() : undefined;

// One owner for each schema type on an article page: this layout.
const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Article',
			'@id': `${canonicalURL}#article`,
			headline: title,
			description,
			image: heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
			datePublished: day(pubDate),
			dateModified: day(updatedDate ?? pubDate),
			articleSection: category,
			author: { '@type': 'Person', name: 'Jay Arr', url: new URL('/about/', Astro.site).toString(), sameAs: ['https://www.youtube.com/@jayarrcoffee'] },
			publisher: { '@type': 'Organization', name: SITE_TITLE, url: site, logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).toString() } },
			mainEntityOfPage: canonicalURL.toString(),
			...(videoId ? { video: { '@id': `${canonicalURL}#video` } } : {}),
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${canonicalURL}#breadcrumbs`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: site },
				{ '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', Astro.site).toString() },
				...(category ? [{ '@type': 'ListItem', position: 3, name: category, item: categoryUrl }] : []),
				{ '@type': 'ListItem', position: category ? 4 : 3, name: title, item: canonicalURL.toString() },
			],
		},
		...(videoId ? [{
			'@type': 'VideoObject',
			'@id': `${canonicalURL}#video`,
			name: title,
			description,
			thumbnailUrl: `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`,
			contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
			embedUrl: `https://www.youtube.com/embed/${videoId}`,
			// The video's own upload date when the front matter gives one; the article's date otherwise.
			uploadDate: day(videoDate ?? pubDate),
		}] : []),
	],
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} isArticle={true} pubDate={pubDate} updatedDate={updatedDate} breadcrumbs={false} />
		<script type="application/ld+json" set:html={JSON.stringify(graph)} />
	</head>
	<body class="post-page">
		<Header />
		<main>
			<header class="post-head">
				{/* Site search: the title counts most, then the deck; the crumbs, byline, share row and related
				    posts repeat on every article, so they stay out of the index (Wave F r2). */}
				<nav aria-label="Breadcrumb" class="crumbs" data-pagefind-ignore>
					<ol>
						<li><a href="/">Home</a></li>
						<li><a href="/blog/">Articles</a></li>
						{category && <li><a href={`/blog/category/${category.toLowerCase()}/`}>{category}</a></li>}
					</ol>
				</nav>
				<h1 data-pagefind-weight="10">{title}</h1>
				{description && <p class="deck" data-pagefind-weight="3">{description}</p>}
				<p class="byline" data-pagefind-ignore>
					<span>By <a href="/about/">Jay Arr</a></span>
					<span><FormattedDate date={pubDate} /></span>
					{updatedDate && day(updatedDate) !== day(pubDate) && <span>Updated <FormattedDate date={updatedDate} /></span>}
					<span id="read-time"></span>
				</p>
				{videoId && isVideoEra && <p class="video-note">This article accompanies our video from {monthYear(videoDate ?? pubDate)}.</p>}
			</header>

			{heroImage && (
				<div class="hero">
					<Image widths={[400, 640, 1020]} sizes="(min-width: 960px) 880px, 100vw" src={heroImage} alt="" loading="eager" fetchpriority="high" />
				</div>
			)}

			<nav id="toc" class="toc" hidden aria-label="In this article">
				<details>
					<summary>In this article</summary>
					<ol id="toc-list"></ol>
				</details>
			</nav>

			<article class="prose" id="article-content">
				<slot />
			</article>

			<div class="after" data-pagefind-ignore="all">
				<ShareButtons title={title} url={canonicalURL.toString()} />
				<RelatedPosts currentId={id} category={category} />
			</div>
		</main>
		<Footer />

		<script>
			const article = document.getElementById('article-content');
			if (article) {
				const words = (article.textContent || '').trim().split(/\s+/).length;
				const rt = document.getElementById('read-time');
				if (rt) rt.textContent = `${Math.max(1, Math.round(words / 230))} min read`;
				const toc = document.getElementById('toc');
				const list = document.getElementById('toc-list');
				const heads = article.querySelectorAll('h2');
				if (toc && list && heads.length >= 4) {
					heads.forEach((h, i) => {
						if (!h.id) h.id = `section-${i + 1}`;
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = `#${h.id}`;
						a.textContent = h.textContent;
						li.appendChild(a);
						list.appendChild(li);
					});
					toc.hidden = false;
					if (window.matchMedia('(min-width: 900px)').matches) toc.querySelector('details')?.setAttribute('open', '');
				}
			}
		</script>
	</body>
</html>

<style is:global>.post-page { background: #f3ede3; }</style>
<style>
	main { color: #2a1d15; }
	.post-head { max-width: 760px; margin: 0 auto; padding: 112px 24px 18px; }
	.crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; padding: 0; font: 500 12px/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
	.crumbs li + li::before { content: '/'; margin-right: 6px; color: #b3a493; }
	/* 24 px tall to tap; the negative margin keeps the line where it was. */
	.crumbs a { color: #75655a; text-decoration: none; display: inline-block; padding: 6px 0; margin: -6px 0; }
	.crumbs a:hover { color: #8f5d22; }
	h1 { font: 400 clamp(38px, 5.6vw, 60px)/1.02 'Instrument Serif', Georgia, serif; letter-spacing: -.01em; margin: 0 0 14px; }
	.deck { font: 400 19px/1.5 'IBM Plex Sans', system-ui, sans-serif; color: #5b4a3d; margin: 0 0 16px; }
	.byline { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; font: 400 13.5px 'IBM Plex Mono', monospace; color: #75655a; }
	.byline a { color: #7a4e30; }
	.video-note { margin: 12px 0 0; font: 400 14px 'IBM Plex Sans', sans-serif; color: #5b4a3d; border-left: 2px solid #c3873a; padding: 4px 0 4px 10px; }
	.hero { max-width: 960px; margin: 10px auto 0; padding: 0 24px; }
	.hero :global(img) { width: 100%; height: auto; border-radius: 14px; display: block; }
	.toc { max-width: 720px; margin: 28px auto 0; padding: 0 24px; }
	.toc details { background: #fbf8f3; border: 1px solid #d9cdbd; border-radius: 12px; padding: 12px 16px; }
	.toc summary { cursor: pointer; font: 500 11px/1 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #75655a; }
	.toc ol { margin: 12px 0 2px; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; }
	.toc :global(a) { color: #7a4e30; display: inline-block; padding: 3px 0; margin: -3px 0; }
	.prose { padding: 34px 24px 16px; }
	.after { max-width: 720px; margin: 0 auto; padding: 0 24px 72px; }
	@media (max-width: 640px) { .post-head { padding: 92px 16px 14px; } .hero, .toc { padding: 0 12px; } .prose { padding: 26px 16px 12px; } .after { padding: 0 16px 56px; } }
</style>
