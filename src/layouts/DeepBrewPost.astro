---
// A Deep Brew research note: the site's one header and footer in the dark variant, leading with the finding and
// its limits (MERGED_PLAN: finding, limitation, figure, then derivation and references), with a contents list
// built from the note's own headings at build time.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { type CollectionEntry, getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'deepbrew'>['data'] & { id: string; headings?: MarkdownHeading[]; minutes?: number };

const { title, description, pubDate, updatedDate, category, id, finding, limitation, headings = [], minutes } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const contents = headings.filter((h) => h.depth === 2);
// Long dates, as across the site; a hyphen between numbers never breaks a line ("2-12").
const longDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const nb = (t: string) => t.replace(/(\d)-(\d)/g, '$1\u2011$2');

// Three more notes: the same field first, then the most recently updated.
const related = (await getCollection('deepbrew'))
	.filter((p) => p.id !== id)
	.sort((a, b) => (Number(b.data.category === category) - Number(a.data.category === category)) || ((b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()))
	.slice(0, 3);

const articleSchema = {
	'@context': 'https://schema.org', '@type': 'Article', headline: title, description,
	datePublished: pubDate.toISOString(), dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Jay Arr', url: Astro.site?.toString() },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.toString() },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
};
const breadcrumbSchema = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
		{ '@type': 'ListItem', position: 2, name: 'Deep Brew', item: new URL('/deep-brew/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: 'Research', item: new URL('/deep-brew/research/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 4, name: title, item: canonicalURL.toString() },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Deep Brew`} description={description} isArticle={true} pubDate={pubDate} updatedDate={updatedDate} breadcrumbs={false} />
		<link rel="alternate" type="application/rss+xml" title="JayArr Coffee: Deep Brew research" href="/deep-brew/rss.xml" />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body class="cf-page db-dark">
		<Header />
		<main class="note">
			<header class="nhead">
				<nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/deep-brew/">Deep Brew</a></li><li><a href="/deep-brew/research/">Research</a></li><li aria-current="page">{category}</li></ol></nav>
				<h1>{nb(title)}</h1>
				<p class="lede">{description}</p>
				<p class="meta">
					<span>Published <time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time></span>
					{updatedDate && <span>Updated <time datetime={updatedDate.toISOString()}>{longDate(updatedDate)}</time></span>}
					{minutes && <span>{minutes} min read</span>}
				</p>
				{(finding || limitation) && (
					<div class="fl">
						{finding && <div class="finding"><p class="lbl">The finding</p><p>{finding}</p></div>}
						{limitation && <div class="limit"><p class="lbl">What it doesn't show</p><p>{limitation}</p></div>}
					</div>
				)}
			</header>

			<div class="body">
				{contents.length >= 3 && (
					<nav class="toc" aria-labelledby="toc-h">
						<p class="lbl" id="toc-h">In this note</p>
						<ol>{contents.map((h) => <li><a href={`#${h.slug}`}>{nb(h.text)}</a></li>)}</ol>
					</nav>
				)}
				<article class="db-prose">
					<slot />
				</article>
			</div>

			{related.length > 0 && (
				<aside class="more" aria-labelledby="more-h">
					<h2 id="more-h">More research</h2>
					<ul>
						{related.map((p) => (
							<li><a href={`/deep-brew/research/${p.id}/`}><span class="cat">{p.data.category}</span><span class="t">{p.data.title}</span></a></li>
						))}
					</ul>
					<p class="feed"><a href="/deep-brew/research/">All research notes</a> · <a href="/deep-brew/rss.xml">Follow by RSS</a></p>
				</aside>
			)}
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.cf-page { background: var(--t-paper, #f3ede3); }
	/* Research prose, on the dark tokens (light fallbacks keep it readable anywhere). */
	.db-prose { font: 400 18px/1.75 'IBM Plex Sans', system-ui, sans-serif; color: var(--t-ink-2, #5b4a3d); min-width: 0; overflow-wrap: break-word; }
	.db-prose > :first-child { margin-top: 0; }
	.db-prose h2 { font: 400 36px/1.1 'Instrument Serif', Georgia, serif; color: var(--t-ink, #2a1d15); margin: 2.4em 0 .5em; scroll-margin-top: 90px; }
	.db-prose h3 { font: 400 25px/1.2 'Instrument Serif', Georgia, serif; color: var(--t-ink, #2a1d15); margin: 1.8em 0 .4em; scroll-margin-top: 90px; }
	.db-prose p { margin: 0 0 1.1em; }
	.db-prose strong { color: var(--t-ink, #2a1d15); font-weight: 600; }
	.db-prose a { color: var(--t-crema-deep, #8f5d22); text-underline-offset: 3px; text-decoration-thickness: 1px; }
	.db-prose ul, .db-prose ol { margin: 0 0 1.2em; padding-left: 1.4em; }
	.db-prose li { margin: 0 0 .45em; }
	.db-prose li::marker { color: var(--t-ink-3, #75655a); }
	.db-prose blockquote { margin: 1.4em 0; padding: 4px 0 4px 18px; border-left: 3px solid var(--t-crema, #c3873a); color: var(--t-ink, #2a1d15); font-style: italic; }
	.db-prose code { font: 400 .88em 'IBM Plex Mono', monospace; background: var(--t-surface, #fff); border: 1px solid var(--t-rule, #d9cdbd); border-radius: 5px; padding: 1px 5px; color: var(--t-ink, #2a1d15); }
	.db-prose pre { overflow-x: auto; background: var(--t-surface, #fff); border: 1px solid var(--t-rule, #d9cdbd); border-radius: 10px; padding: 14px 16px; }
	.db-prose pre code { border: 0; padding: 0; background: none; }
	.db-prose table { width: 100%; border-collapse: collapse; font-size: 15.5px; margin: 1.4em 0; display: block; overflow-x: auto; }
	.db-prose th, .db-prose td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--t-rule, #d9cdbd); vertical-align: top; }
	.db-prose thead th { font: 500 11px/1.3 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--t-ink-3, #75655a); }
	.db-prose td { color: var(--t-ink-2, #5b4a3d); }
	.db-prose hr { border: 0; border-top: 1px solid var(--t-rule, #d9cdbd); margin: 2.4em 0; }
	.db-prose img { max-width: 100%; height: auto; border-radius: 10px; }
	.db-prose figure { margin: 1.6em 0; }
	.db-prose figcaption { font-size: 14px; color: var(--t-ink-3, #75655a); margin-top: 8px; }
	/* A displayed equation: <p class="eq">Q = k·A·ΔP / (μ·L)</p>, with a sentence after it saying what it means. */
	.db-prose .eq { font: 500 19px/1.5 'IBM Plex Mono', monospace; color: var(--t-ink, #2a1d15); text-align: center; padding: 14px 16px; margin: 1.4em 0; border: 1px solid var(--t-rule, #d9cdbd); border-radius: 12px; background: var(--t-card, #fbf8f3); overflow-x: auto; white-space: nowrap; }
</style>
<style>
	.note { color: var(--t-ink, #2a1d15); }
	.nhead { max-width: 1040px; margin: 0 auto; padding: 116px 24px 8px; }
	.crumbs { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font: 500 11.5px/1.4 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
	.crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--t-ink-4, #9c8f82); }
	.crumbs a { color: var(--t-ink-3, #75655a); text-decoration: none; }
	.crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
	.crumbs [aria-current] { color: var(--t-crema-deep, #8f5d22); }
	h1 { font: 400 clamp(38px, 5.4vw, 64px)/1.02 'Instrument Serif', Georgia, serif; letter-spacing: -.005em; margin: 0 0 14px; max-width: 22ch; }
	.lede { font-size: 19px; line-height: 1.55; color: var(--t-ink-2, #5b4a3d); max-width: 62ch; margin: 0 0 14px; }
	.meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; font: 500 12px/1.4 'IBM Plex Mono', monospace; color: var(--t-ink-3, #75655a); }
	.fl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 26px 0 0; max-width: 1040px; }
	.fl > div { padding: 14px 16px; border-radius: 14px; border: 1px solid var(--t-rule, #d9cdbd); background: var(--t-card, #fbf8f3); }
	.finding { border-left: 3px solid var(--t-crema, #c3873a) !important; }
	.limit { border-left: 3px solid var(--t-water, #2f7484) !important; }
	.fl p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--t-ink, #2a1d15); }
	.lbl { font: 500 11px/1.3 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--t-ink-3, #75655a); margin: 0 0 6px !important; }

	.body { max-width: 1040px; margin: 0 auto; padding: 34px 24px 24px; display: grid; grid-template-columns: minmax(0, 720px) minmax(0, 1fr); gap: 48px; align-items: start; }
	.body .db-prose { grid-column: 1; grid-row: 1; }
	.toc { grid-column: 2; grid-row: 1; position: sticky; top: 96px; border-left: 1px solid var(--t-rule, #d9cdbd); padding-left: 16px; }
	.toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; counter-reset: s; }
	.toc li { counter-increment: s; display: grid; grid-template-columns: 22px 1fr; font-size: 14px; line-height: 1.4; }
	.toc li::before { content: counter(s, decimal-leading-zero); font: 500 11px/1.6 'IBM Plex Mono', monospace; color: var(--t-ink-4, #9c8f82); }
	.toc a { color: var(--t-ink-2, #5b4a3d); text-decoration: none; }
	.toc a:hover { color: var(--t-ink, #2a1d15); text-decoration: underline; text-underline-offset: 3px; }

	.more { max-width: 1040px; margin: 0 auto; padding: 28px 24px 80px; border-top: 1px solid var(--t-rule, #d9cdbd); }
	.more h2 { font: 400 32px/1.1 'Instrument Serif', Georgia, serif; margin: 0 0 14px; }
	.more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
	.more a { display: grid; gap: 6px; height: 100%; box-sizing: border-box; padding: 14px 16px; border: 1px solid var(--t-rule, #d9cdbd); border-radius: 12px; background: var(--t-card, #fbf8f3); text-decoration: none; color: inherit; }
	.more a:hover { border-color: var(--t-ink-3, #75655a); }
	.cat { font: 500 10.5px 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--t-crema-deep, #8f5d22); }
	.t { font: 400 20px/1.15 'Instrument Serif', Georgia, serif; color: var(--t-ink, #2a1d15); }
	.feed { margin: 16px 0 0; font-size: 14.5px; color: var(--t-ink-3, #75655a); }
	.feed a { color: var(--t-crema-deep, #8f5d22); text-underline-offset: 3px; }
	a:focus-visible { outline: 2px solid var(--t-crema-deep, #8f5d22); outline-offset: 3px; border-radius: 3px; }

	@media (max-width: 1000px) {
		.body { grid-template-columns: minmax(0, 1fr); gap: 20px; max-width: 768px; }
		.toc { grid-column: 1; grid-row: 1; position: static; border-left: 0; padding: 14px 16px; border: 1px solid var(--t-rule, #d9cdbd); border-radius: 12px; background: var(--t-card, #fbf8f3); }
		.body .db-prose { grid-row: 2; }
		.nhead { max-width: 768px; }
		.more { max-width: 768px; }
		.more ul { grid-template-columns: 1fr; }
	}
	@media (max-width: 640px) { .nhead { padding: 96px 16px 6px; } .body { padding: 24px 16px 16px; } .more { padding: 24px 16px 64px; } .fl { grid-template-columns: 1fr; } .db-prose { font-size: 17px; } }
</style>
