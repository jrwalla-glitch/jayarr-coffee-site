---
// A tool, in context, inside an article. Names, links and blurbs come from the one tool list
// (src/data/tools.ts). `preset` opens the tool on the article's own brew, e.g.
// <ToolCallout tool="brew" preset={{ method: 'v60', dose: 22, ratio: 16 }} context="…" />
import { toolById } from '../data/tools.ts';

// The keys articles used before the tool list existed still work.
const LEGACY: Record<string, string> = {
	'brew-ratio': 'brew', 'fix-my-coffee': 'doctor', 'grind-guide': 'grind', 'drink-builder': 'drinks',
	'espresso-machines': 'machines', 'nespresso-pods': 'pods',
};

interface Props {
	tool: string;
	context?: string;
	preset?: Record<string, string | number>;
	/** The button's words; by default it says the tool opens with these settings, not "this recipe". */
	cta?: string;
}

const { tool, context, preset, cta } = Astro.props;
const data = toolById(LEGACY[tool] ?? tool);
if (!data) throw new Error(`ToolCallout: unknown tool "${tool}"`);
const query = preset ? `?${new URLSearchParams(Object.entries(preset).map(([k, v]) => [k, String(v)])).toString()}` : '';
const href = `${data.href}${query}`;
---

<aside class="tool-callout" aria-label={`Try the ${data.name}`}>
	<p class="tc-kicker">{data.deepBrew ? 'Deep Brew tool' : 'Tool'}</p>
	<p class="tc-title">{data.name}</p>
	<p class="tc-desc">{context || `${data.blurb}.`}</p>
	<a href={href} class="tc-link">{cta ?? (preset ? 'Open it with these settings' : 'Open the tool')} <span aria-hidden="true">→</span></a>
</aside>

<style>
	.tool-callout {
		max-width: 720px;
		margin: 2rem auto;
		padding: 1.1rem 1.35rem 1.2rem;
		background: var(--color-card, #FBF8F3);
		border: 1px solid var(--color-rule, #D9CDBD);
		border-left: 3px solid var(--color-crema-deep, #8F5D22);
		border-radius: 0 12px 12px 0;
	}
	.tc-kicker {
		font: 500 11px/1 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
		color: var(--color-crema-deep, #8F5D22);
		margin: 0 0 .45rem;
	}
	.tc-title {
		font: 400 1.6rem/1.1 var(--font-serif);
		color: var(--color-ink, #2A1D15);
		margin: 0 0 .3rem;
	}
	.tc-desc {
		font: 400 1rem/1.55 var(--font-sans);
		color: var(--color-ink-2, #5B4A3D);
		margin: 0 0 .75rem;
	}
	.tc-link {
		display: inline-flex;
		align-items: center;
		gap: .35rem;
		min-height: 44px;
		padding: 0 1rem;
		border-radius: 999px;
		background: var(--color-ink, #2A1D15);
		/* On a dark page the ink is light, so the text takes the dark theme's on-ink colour (Deep Brew a11y). */
		color: var(--t-on-ink, #F3EDE3);
		font: 600 14px/1 var(--font-sans);
		text-decoration: none;
	}
	.tc-link:hover { background: var(--color-coffee, #7A4E30); }
	.tc-link:focus-visible { outline: 2px solid var(--color-crema-deep, #8F5D22); outline-offset: 2px; }
</style>
