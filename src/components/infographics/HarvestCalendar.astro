---
interface Origin {
	name: string;
	group: string;
	harvest: number[];
	arrival: number[];
}

interface QuarterTip {
	label: string;
	buy: string;
	arriving: string;
}

interface Props {
	title: string;
	subtitle: string;
	origins: Origin[];
	tips?: QuarterTip[];
	footnote?: string;
}

const { title, subtitle, origins, tips, footnote } = Astro.props;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Group origins by region
const groups = [...new Set(origins.map((o) => o.group))];
---

<aside class="infographic-calendar" role="complementary" aria-label={title}>
	<header class="ig-header">
		<span class="ig-brand">Season by season</span>
		<p class="ig-title">{title}</p>
		<p class="ig-subtitle">{subtitle}</p>
	</header>

	<!-- Legend -->
	<div class="cal-legend">
		<span class="legend-item"><span class="legend-dot legend-harvest"></span> Harvest</span>
		<span class="legend-item"><span class="legend-dot legend-arrival"></span> Peak Arrival</span>
	</div>

	<!-- Calendar Grid -->
	<div class="cal-scroll" tabindex="0" role="region" aria-label={`${title} calendar`}>
		<table class="cal-table" role="grid">
			<thead>
				<tr>
					<th class="col-origin">Origin</th>
					{months.map((m) => <th class="col-month">{m}</th>)}
				</tr>
			</thead>
			<tbody>
				{groups.map((group) => (
					<>
						<tr class="group-row">
							<td colspan="13" class="group-label">{group}</td>
						</tr>
						{origins
							.filter((o) => o.group === group)
							.map((origin) => (
								<tr class="origin-row">
									<td class="origin-name">{origin.name}</td>
									{months.map((_, i) => {
										const month = i + 1;
										const isHarvest = origin.harvest.includes(month);
										const isArrival = origin.arrival.includes(month);
										return (
											<td
												class:list={[
													'cal-cell',
													isHarvest && isArrival && 'cell-both',
													isHarvest && !isArrival && 'cell-harvest',
													!isHarvest && isArrival && 'cell-arrival',
												]}
												aria-label={
													isHarvest && isArrival
														? `${origin.name} ${months[i]}: harvest and arrival`
														: isHarvest
															? `${origin.name} ${months[i]}: harvest`
															: isArrival
																? `${origin.name} ${months[i]}: arrival`
																: undefined
												}
											>
												{isHarvest && isArrival ? '●' : isHarvest ? '●' : isArrival ? '●' : ''}
											</td>
										);
									})}
								</tr>
							))}
					</>
				))}
			</tbody>
		</table>
	</div>

	<!-- Quarterly Strategy Tips -->
	{tips && tips.length > 0 && (
		<div class="cal-tips">
			{tips.map((tip) => (
				<div class="tip-box">
					<span class="tip-label">{tip.label}</span>
					<p class="tip-buy"><strong>Buy:</strong> {tip.buy}</p>
					<p class="tip-arriving"><strong>Arriving:</strong> {tip.arriving}</p>
				</div>
			))}
		</div>
	)}

	{footnote && <p class="cal-footnote">{footnote}</p>}

</aside>

<style>
  .infographic-calendar {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  .cal-footnote { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); margin: 1.2rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--color-rule, #D9CDBD); }
  @media (max-width: 480px) {
    .infographic-calendar { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .cal-legend { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin-bottom: 1.2rem; }
  .legend-item { display: flex; align-items: center; gap: .4rem; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-2, #5B4A3D); }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
  .legend-harvest { background: var(--color-crema-deep, #8F5D22); }
  .legend-arrival { background: var(--color-water, #2F7484); }
  .cal-scroll { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .cal-scroll:focus-visible { outline: 2px solid var(--color-crema-deep, #8F5D22); outline-offset: 3px; }
  .cal-table { width: 100%; min-width: 600px; border-collapse: collapse; margin: 0; overflow-wrap: normal; }
  .cal-table th { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-3, #75655A); padding: .75rem .25rem; text-align: center; border-bottom: 2px solid var(--color-rule, #D9CDBD); }
  .cal-table .col-origin { text-align: left; min-width: 120px; position: sticky; left: 0; background: var(--color-card, #FBF8F3); z-index: 1; }
  .col-month { width: calc((100% - 120px) / 12); }
  .cal-table .group-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); padding: .9rem 0 .4rem; border: 0; background: var(--color-card, #FBF8F3); }
  .cal-table td { border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .cal-table .origin-name { font-size: .8125rem; line-height: 1.5; color: var(--color-ink, #2A1D15); padding: .6rem .5rem .6rem 0; white-space: nowrap; position: sticky; left: 0; background: var(--color-card, #FBF8F3); z-index: 1; }
  .cal-table .cal-cell { text-align: center; padding: .4rem .125rem; font: 400 .75rem/1 var(--font-mono); }
  .cell-harvest { color: var(--color-crema-deep, #8F5D22); background: var(--color-paper, #F3EDE3); }
  .cell-arrival { color: var(--color-water, #2F7484); background: var(--color-card, #FBF8F3); }
  .cell-both { color: var(--color-crema-deep, #8F5D22); background: var(--color-paper, #F3EDE3); box-shadow: inset 0 -3px 0 var(--color-water, #2F7484); }
  .cal-table tbody tr:hover { background: var(--color-paper, #F3EDE3); }
  .cal-tips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1.5rem; }
  .tip-box { background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; padding: 1rem; }
  .tip-label { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .5rem; }
  .tip-buy, .tip-arriving { font-size: .875rem; color: var(--color-ink-2, #5B4A3D); margin: .3rem 0; line-height: 1.5; }
  @media (max-width: 480px) { .cal-tips { grid-template-columns: 1fr; } }
</style>
