---
interface RankingItem {
  name: string;
  specs: string[];
  price: string;
  highlight?: string;
}

interface Props {
  title: string;
  subtitle: string;
  columns: string[];
  items: RankingItem[];
  tip?: string;
}

const { title, subtitle, columns, items, tip } = Astro.props;
---

<aside class="infographic-ranking" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">At a glance</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <div class="ig-divider"></div>

  <div class="ranking-header" role="row" aria-hidden="true">
    <span class="col-rank">#</span>
    <span class="col-name">Name</span>
    {columns.map((col) => <span class="col-spec">{col}</span>)}
    <span class="col-price">Price</span>
  </div>

  {items.map((item, i) => (
    <div class="ranking-row" role="row">
      <span class="row-rank">{i + 1}</span>
      <div class="row-main">
        <span class="row-name">{item.name}</span>
        {item.highlight && <span class="row-highlight">{item.highlight}</span>}
      </div>
      <div class="row-specs">
        {item.specs.map((spec) => <span class="row-spec">{spec}</span>)}
      </div>
      <span class="row-price">{item.price}</span>
    </div>
  ))}

  {tip && (
    <div class="ranking-tip">
      <span class="tip-label">Tip:</span> {tip}
    </div>
  )}

</aside>

<style>
  .ig-divider { display: none; }
  .infographic-ranking {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  @media (max-width: 480px) {
    .infographic-ranking { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .ranking-header { display: none; }
  .ranking-row { display: grid; grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 1.2fr) minmax(4rem, auto); align-items: start; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .row-rank { font: 400 1.4rem/1.2 var(--font-mono); color: var(--color-crema-deep, #8F5D22); }
  .row-main { min-width: 0; }
  .row-name { font: 400 1.35rem/1.2 var(--font-serif); color: var(--color-ink, #2A1D15); display: block; margin-bottom: .35rem; }
  .row-highlight { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); }
  .row-specs { display: flex; flex-wrap: wrap; gap: .35rem .75rem; min-width: 0; }
  .row-spec { font-size: .875rem; line-height: 1.5; color: var(--color-ink-2, #5B4A3D); }
  .row-price { font: 400 .875rem/1.5 var(--font-mono); color: var(--color-crema-deep, #8F5D22); text-align: right; }
  .ranking-tip { background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; padding: 1rem; margin-top: 1.2rem; font-size: .875rem; line-height: 1.6; color: var(--color-ink-2, #5B4A3D); }
  .tip-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); }
  @media (max-width: 600px) {
    .ranking-row { grid-template-columns: 1.5rem minmax(0, 1fr) minmax(3rem, auto); gap: .6rem; }
    .row-rank { font-size: 1.1rem; }
    .row-specs { grid-column: 2 / -1; grid-row: 2; }
    .row-price { grid-column: 3; grid-row: 1; }
  }

</style>
