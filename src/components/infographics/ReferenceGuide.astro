---
interface GuideItem {
  label: string;
  description: string;
  value: string;
  /** Relative size 0-1 for visual indicator dot (optional) */
  dotScale?: number;
}

interface Props {
  title: string;
  subtitle: string;
  items: GuideItem[];
  scaleLabel?: { start: string; end: string };
  footnote?: string;
}

const { title, subtitle, items, scaleLabel, footnote } = Astro.props;
---

<aside class="infographic-reference" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">Quick reference</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  {scaleLabel && (
    <div class="scale-bar">
      <span class="scale-label">{scaleLabel.start}</span>
      <div class="scale-track">
        <div class="scale-fill"></div>
      </div>
      <span class="scale-label">{scaleLabel.end}</span>
    </div>
  )}

  <div class="ig-divider"></div>

  {items.map((item) => (
    <div class="guide-row">
      {item.dotScale !== undefined && (
        <div class="dot-container">
          <div
            class="dot"
            style={`width: ${Math.max(8, item.dotScale * 24)}px; height: ${Math.max(8, item.dotScale * 24)}px;`}
          />
        </div>
      )}
      <div class="guide-main">
        <span class="guide-label">{item.label}</span>
        <span class="guide-desc">{item.description}</span>
      </div>
      <span class="guide-value">{item.value}</span>
    </div>
  ))}

  {footnote && <p class="ig-footnote">{footnote}</p>}

</aside>

<style>
  .ig-divider { display: none; }
  .infographic-reference {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  .ig-footnote { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); margin: 1.2rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--color-rule, #D9CDBD); }
  @media (max-width: 480px) {
    .infographic-reference { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .scale-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-bottom: 1.2rem; }
  .scale-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-3, #75655A); }
  .scale-track { flex: 1; min-width: 2rem; height: 6px; background: var(--color-paper, #F3EDE3); border-radius: 3px; overflow: hidden; }
  .scale-fill { height: 100%; width: 100%; background: linear-gradient(to right, var(--color-copper, #C17A3A), var(--color-crema-deep, #8F5D22)); }
  .guide-row { display: flex; align-items: center; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .dot-container { width: 2rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .dot { border-radius: 50%; background: var(--color-copper, #C17A3A); }
  .guide-main { flex: 1; min-width: 0; }
  .guide-label { font: 400 1.3rem/1.2 var(--font-serif); color: var(--color-ink, #2A1D15); display: block; margin-bottom: .3rem; }
  .guide-desc { font-size: .875rem; line-height: 1.5; color: var(--color-ink-2, #5B4A3D); }
  .guide-value { flex: 0 1 42%; min-width: 0; font: 400 .875rem/1.5 var(--font-mono); color: var(--color-crema-deep, #8F5D22); text-align: right; }
  @media (max-width: 480px) {
    .guide-row { flex-wrap: wrap; gap: .5rem .6rem; }
    .guide-main { flex-basis: 70%; }
    .guide-value { flex-basis: 100%; text-align: left; }
    .guide-row:has(.dot-container) .guide-value { padding-left: 2.6rem; }
  }

</style>
