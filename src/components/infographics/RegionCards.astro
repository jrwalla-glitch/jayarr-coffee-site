---
interface Region {
  name: string;
  altitude: string;
  location: string;
  flavors: string[];
  bestFor: string;
  note: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  subtitle: string;
  regions: Region[];
  stats?: Stat[];
}

const { title, subtitle, regions, stats } = Astro.props;
---

<aside class="infographic-region-cards" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">At a glance</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <div class="ig-divider"></div>

  {regions.map((region, i) => (
    <div class="region-card">
      <div class="rank-number">{String(i + 1).padStart(2, '0')}</div>
      <div class="region-content">
        <div class="region-top-row">
          <span class="region-name">{region.name}</span>
          <span class="altitude">{region.altitude}</span>
        </div>
        <div class="region-location">{region.location}</div>
        <div class="section-label">Flavor Profile</div>
        <div class="flavor-tags">
          {region.flavors.map((f) => <span class="tag">{f}</span>)}
        </div>
        <div class="section-label">Best For</div>
        <div class="best-for">{region.bestFor}</div>
        <div class="region-note">{region.note}</div>
      </div>
    </div>
  ))}

  {stats && stats.length > 0 && (
    <div class="stats-bar">
      {stats.map((stat, i) => (
        <>
          {i > 0 && <div class="stat-divider" />}
          <div class="stat">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        </>
      ))}
    </div>
  )}

</aside>

<style>
  .ig-divider { display: none; }
  .infographic-region-cards {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  @media (max-width: 480px) {
    .infographic-region-cards { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .region-card { display: flex; align-items: flex-start; gap: 1.2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .rank-number { flex: 0 0 3rem; font: 400 1.8rem/1 var(--font-mono); color: var(--color-crema-deep, #8F5D22); padding-top: .2rem; }
  .region-content { flex: 1; min-width: 0; }
  .region-top-row { display: flex; align-items: baseline; gap: .4rem 1rem; flex-wrap: wrap; margin-bottom: .35rem; }
  .region-name { font: 400 1.6rem/1.15 var(--font-serif); color: var(--color-ink, #2A1D15); }
  .altitude { font: 400 .75rem/1.5 var(--font-mono); color: var(--color-crema-deep, #8F5D22); }
  .region-location, .section-label, .stat-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-3, #75655A); }
  .region-location { margin-bottom: 1rem; }
  .section-label { margin-bottom: .4rem; }
  .flavor-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .tag { font-size: .8125rem; line-height: 1.5; color: var(--color-ink, #2A1D15); padding: .3rem .7rem; border-radius: 12px; border: 1px solid var(--color-rule, #D9CDBD); background: var(--color-paper, #F3EDE3); max-width: 100%; }
  .best-for { font-size: .875rem; line-height: 1.6; color: var(--color-ink-2, #5B4A3D); margin-bottom: .75rem; }
  .region-note { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); }
  .stats-bar { background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; margin-top: 1.4rem; padding: 1.2rem; display: flex; flex-wrap: wrap; justify-content: space-around; gap: 1rem; }
  .stat { flex: 1 1 7rem; min-width: 0; text-align: center; }
  .stat-value { font: 400 1.5rem/1.3 var(--font-mono); color: var(--color-ink, #2A1D15); }
  .stat-label { margin-top: .4rem; }
  .stat-divider { display: none; }
  @media (max-width: 480px) {
    .region-card { gap: .7rem; }
    .rank-number { flex-basis: 2rem; font-size: 1.2rem; }
    .region-name { font-size: 1.35rem; }
  }

</style>
