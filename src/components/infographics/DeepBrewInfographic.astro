---
/**
 * Wrapper for infographic components in Deep Brew research notes. The page's .db-dark theme sets the
 * shared substance tokens, so the components inherit the warm dark palette with nothing to override here.
 *
 * Usage in MDX:
 *   <DeepBrewInfographic>
 *     <ComparisonTable title="..." subtitle="..." columns={[...]} rows={[...]} />
 *   </DeepBrewInfographic>
 */
---

<div class="db-ig-wrapper">
	<slot />
</div>
