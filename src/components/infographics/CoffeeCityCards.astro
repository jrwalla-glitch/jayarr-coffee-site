---
interface City {
  name: string;
  country: string;
  sceneFounded: string;
  anchorRoaster: string;
  signatureStyle: string;
  bestFor: string;
  wave: "second" | "specialty" | "third" | "fourth";
  note?: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  subtitle: string;
  cities: City[];
  stats?: Stat[];
}

const { title, subtitle, cities, stats } = Astro.props;

const waveLabel: Record<City["wave"], string> = {
  second: "Second wave",
  specialty: "Specialty transition",
  third: "Third wave",
  fourth: "Fourth wave",
};
---

<aside class="infographic-city-cards" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">At a glance</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <div class="ig-divider"></div>

  {cities.map((city, i) => (
    <div class="city-card">
      <div class="rank-number">{String(i + 1).padStart(2, '0')}</div>
      <div class="city-content">
        <div class="city-top-row">
          <div class="city-name-wrap">
            <span class={`wave-dot wave-${city.wave}`} aria-label={waveLabel[city.wave]} title={waveLabel[city.wave]}></span>
            <span class="city-name">{city.name}</span>
          </div>
          <span class="scene-founded">Scene founded {city.sceneFounded}</span>
        </div>
        <div class="city-country">{city.country}</div>
        <div class="section-label">Anchor Roaster</div>
        <div class="anchor-roaster">{city.anchorRoaster}</div>
        <div class="section-label">Signature Style</div>
        <div class="style-tags">
          <span class="tag">{city.signatureStyle}</span>
        </div>
        <div class="section-label">Best For</div>
        <div class="best-for">{city.bestFor}</div>
        {city.note && <div class="city-note">{city.note}</div>}
      </div>
    </div>
  ))}

  {stats && stats.length > 0 && (
    <div class="stats-bar">
      {stats.map((stat, i) => (
        <>
          {i > 0 && <div class="stat-divider" />}
          <div class="stat">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        </>
      ))}
    </div>
  )}

</aside>

<style>
  .ig-divider { display: none; }
  .infographic-city-cards {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  @media (max-width: 480px) {
    .infographic-city-cards { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .city-card { display: flex; align-items: flex-start; gap: 1.2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .rank-number { flex: 0 0 3rem; font: 400 1.8rem/1 var(--font-mono); color: var(--color-crema-deep, #8F5D22); padding-top: .2rem; }
  .city-content { flex: 1; min-width: 0; }
  .city-top-row { display: flex; align-items: baseline; gap: .4rem 1rem; flex-wrap: wrap; margin-bottom: .35rem; }
  .city-name { font: 400 1.6rem/1.15 var(--font-serif); color: var(--color-ink, #2A1D15); }
  .scene-founded { font: 400 .75rem/1.5 var(--font-mono); color: var(--color-crema-deep, #8F5D22); }
  .city-country, .section-label, .stat-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-3, #75655A); }
  .city-country { margin-bottom: 1rem; }
  .section-label { margin-bottom: .4rem; }
  .style-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .tag { font-size: .8125rem; line-height: 1.5; color: var(--color-ink, #2A1D15); padding: .3rem .7rem; border-radius: 12px; border: 1px solid var(--color-rule, #D9CDBD); background: var(--color-paper, #F3EDE3); max-width: 100%; }
  .best-for, .anchor-roaster { font-size: .875rem; line-height: 1.6; color: var(--color-ink-2, #5B4A3D); margin-bottom: .75rem; }
  .city-note { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); }
  .stats-bar { background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; margin-top: 1.4rem; padding: 1.2rem; display: flex; flex-wrap: wrap; justify-content: space-around; gap: 1rem; }
  .stat { flex: 1 1 7rem; min-width: 0; text-align: center; }
  .stat-value { font: 400 1.5rem/1.3 var(--font-mono); color: var(--color-ink, #2A1D15); }
  .stat-label { margin-top: .4rem; }
  .stat-divider { display: none; }
  @media (max-width: 480px) {
    .city-card { gap: .7rem; }
    .rank-number { flex-basis: 2rem; font-size: 1.2rem; }
    .city-name { font-size: 1.35rem; }
  }

  .city-name-wrap { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .wave-dot { display: inline-block; width: .625rem; height: .625rem; border-radius: 50%; flex-shrink: 0; }
  .wave-second { background: var(--color-ink-3, #75655A); }
  .wave-specialty { background: var(--color-crema-deep, #8F5D22); }
  .wave-third { background: var(--color-copper, #C17A3A); }
  .wave-fourth { background: var(--color-water, #2F7484); }

</style>
