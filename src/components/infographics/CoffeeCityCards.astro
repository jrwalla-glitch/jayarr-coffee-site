---
interface City {
  name: string;
  country: string;
  sceneFounded: string;
  anchorRoaster: string;
  signatureStyle: string;
  bestFor: string;
  wave: "second" | "specialty" | "third" | "fourth";
  note?: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  subtitle: string;
  cities: City[];
  stats?: Stat[];
}

const { title, subtitle, cities, stats } = Astro.props;

const waveLabel: Record<City["wave"], string> = {
  second: "Second wave",
  specialty: "Specialty transition",
  third: "Third wave",
  fourth: "Fourth wave",
};
---

<aside class="infographic-city-cards" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">JayArr Coffee</span>
    <h2 class="ig-title">{title}</h2>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <div class="ig-divider"></div>

  {cities.map((city, i) => (
    <div class="city-card">
      <div class="rank-number">{String(i + 1).padStart(2, '0')}</div>
      <div class="city-content">
        <div class="city-top-row">
          <div class="city-name-wrap">
            <span class={`wave-dot wave-${city.wave}`} aria-label={waveLabel[city.wave]} title={waveLabel[city.wave]}></span>
            <span class="city-name">{city.name}</span>
          </div>
          <span class="scene-founded">Scene founded {city.sceneFounded}</span>
        </div>
        <div class="city-country">{city.country}</div>
        <div class="section-label">Anchor Roaster</div>
        <div class="anchor-roaster">{city.anchorRoaster}</div>
        <div class="section-label">Signature Style</div>
        <div class="style-tags">
          <span class="tag">{city.signatureStyle}</span>
        </div>
        <div class="section-label">Best For</div>
        <div class="best-for">{city.bestFor}</div>
        {city.note && <div class="city-note">{city.note}</div>}
      </div>
    </div>
  ))}

  {stats && stats.length > 0 && (
    <div class="stats-bar">
      {stats.map((stat, i) => (
        <>
          {i > 0 && <div class="stat-divider" />}
          <div class="stat">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        </>
      ))}
    </div>
  )}

  <div class="ig-footer">jayarr.coffee</div>
</aside>

<style>
  .infographic-city-cards {
    max-width: 720px;
    margin: 2.5rem auto;
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--color-charcoal, #1A1A1A);
    -webkit-font-smoothing: antialiased;
  }

  .ig-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .ig-brand {
    display: block;
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-copper, #C17A3A);
    margin-bottom: 0.75rem;
  }

  .ig-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    font-size: 2.5rem;
    color: var(--color-charcoal, #1A1A1A);
    line-height: 1.15;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .ig-subtitle {
    font-size: 1rem;
    color: var(--color-warm-gray, #6B6560);
    margin: 0;
  }

  .ig-divider {
    height: 1px;
    background: var(--color-warm-gray-light, #9B9590);
    opacity: 0.4;
    margin-bottom: 1.5rem;
  }

  .city-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(155, 149, 144, 0.25);
  }

  .city-card:last-of-type {
    border-bottom: none;
  }

  .rank-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 3rem;
    color: var(--color-copper, #C17A3A);
    line-height: 1;
    min-width: 4rem;
    text-align: right;
    padding-top: 2px;
  }

  .city-content {
    flex: 1;
    min-width: 0;
  }

  .city-top-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .city-name-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wave-dot {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .wave-second {
    background: #9B9590;
  }

  .wave-specialty {
    background: #D4A24E;
  }

  .wave-third {
    background: var(--color-copper, #C17A3A);
  }

  .wave-fourth {
    background: #4F7942;
  }

  .city-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.625rem;
    color: var(--color-charcoal, #1A1A1A);
    line-height: 1.2;
  }

  .scene-founded {
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--color-copper, #C17A3A);
    white-space: nowrap;
  }

  .city-country {
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-warm-gray, #6B6560);
    margin-bottom: 1.25rem;
  }

  .section-label {
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-warm-gray, #6B6560);
    margin-bottom: 0.625rem;
  }

  .anchor-roaster {
    font-size: 0.875rem;
    color: var(--color-charcoal, #1A1A1A);
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .style-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--color-charcoal, #1A1A1A);
    padding: 0.375rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--color-copper, #C17A3A);
    background: var(--color-cream, #F5F0E8);
  }

  .best-for {
    font-size: 0.875rem;
    color: var(--color-warm-gray, #6B6560);
    margin-bottom: 0.625rem;
    line-height: 1.45;
  }

  .city-note {
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--color-warm-gray-light, #9B9590);
    line-height: 1.45;
  }

  .stats-bar {
    background: var(--color-cream-dark, #EBE4D8);
    border-top: 2px solid var(--color-copper, #C17A3A);
    margin-top: 2rem;
    padding: 1.5rem 0;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-charcoal, #1A1A1A);
    line-height: 1.2;
  }

  .stat-label {
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-warm-gray, #6B6560);
    margin-top: 0.25rem;
  }

  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: var(--color-warm-gray-light, #9B9590);
    opacity: 0.4;
  }

  .ig-footer {
    text-align: center;
    padding: 1.25rem 0 0;
    font-size: 0.75rem;
    color: var(--color-warm-gray-light, #9B9590);
  }

  @media (max-width: 480px) {
    .rank-number {
      font-size: 2rem;
      min-width: 2.5rem;
    }
    .ig-title {
      font-size: 1.75rem;
    }
    .city-name {
      font-size: 1.25rem;
    }
    .stats-bar {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .stat-divider {
      display: none;
    }
  }
</style>
