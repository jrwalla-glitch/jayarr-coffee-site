---
interface Metric {
  label: string;
  value: string;
  color?: string;
}

interface MethodCard {
  name: string;
  metrics: Metric[];
  notes: string[];
}

interface Props {
  title: string;
  subtitle: string;
  methods: MethodCard[];
  footnote?: string;
}

const { title, subtitle, methods, footnote } = Astro.props;
---

<aside class="infographic-methods" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">Compare</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <div class="ig-divider"></div>

  <div class="methods-grid">
    {methods.map((method) => (
      <div class="method-card">
        <p class="method-name">{method.name}</p>
        <div class="method-metrics">
          {method.metrics.map((metric) => (
            <div class="metric">
              <span class="metric-label">{metric.label}</span>
              <span class="metric-value" style={metric.color ? `--metric-accent: ${metric.color}` : ''}>
                {metric.value}
              </span>
            </div>
          ))}
        </div>
        <div class="method-notes">
          {method.notes.map((note) => <p class="note">{note}</p>)}
        </div>
      </div>
    ))}
  </div>

  {footnote && <p class="ig-footnote">{footnote}</p>}

</aside>

<style>
  .ig-divider { display: none; }
  .infographic-methods {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  .ig-footnote { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); margin: 1.2rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--color-rule, #D9CDBD); }
  @media (max-width: 480px) {
    .infographic-methods { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  .methods-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem; }
  .method-card { min-width: 0; background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; padding: 1.2rem; }
  .method-name { font: 400 1.5rem/1.15 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 1rem; padding-bottom: .75rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .method-metrics { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.2rem; }
  .metric-label { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-3, #75655A); margin-bottom: .3rem; }
  .metric-value { display: inline-block; font: 400 1.125rem/1.4 var(--font-mono); color: var(--color-crema-deep, #8F5D22); border-left: 3px solid var(--metric-accent, var(--color-crema-deep, #8F5D22)); padding-left: .6rem; }
  .method-notes { border-top: 1px solid var(--color-rule, #D9CDBD); padding-top: .75rem; }
  .note { font-size: .875rem; color: var(--color-ink-2, #5B4A3D); margin: .3rem 0; line-height: 1.5; }

</style>
