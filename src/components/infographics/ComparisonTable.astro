---
interface Row {
  name: string;
  values: string[];
  result?: string;
}

interface Props {
  title: string;
  subtitle: string;
  columns: string[];
  rows: Row[];
  rowLabel?: string;
  footnote?: string;
}

const { title, subtitle, columns, rows, rowLabel = '', footnote } = Astro.props;
---

<aside class="infographic-comparison" role="complementary" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">Compare</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <p class="scroll-hint" aria-hidden="true">Scroll sideways for the whole table →</p>
  <div class="table-wrapper" tabindex="0" role="region" aria-label={`${title} table`}>
    <table>
      <thead>
        <tr>
          {rowLabel && <th class="col-name">{rowLabel}</th>}
          {!rowLabel && <th class="col-name"></th>}
          {columns.map((col) => <th>{col}</th>)}
          {rows[0]?.result !== undefined && <th class="col-result">Result</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="cell-name">{row.name}</td>
            {row.values.map((val) => <td>{val}</td>)}
            {row.result !== undefined && <td class="cell-result">{row.result}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {footnote && <p class="ig-footnote">{footnote}</p>}

</aside>

<style>
  .infographic-comparison {
    box-sizing: border-box;
    min-width: 0;
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
    overflow-wrap: anywhere;
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand { display: block; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin-bottom: .6rem; }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 400 .875rem/1.5 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  .ig-footnote { font-size: .875rem; line-height: 1.5; color: var(--color-ink-3, #75655A); margin: 1.2rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--color-rule, #D9CDBD); }
  @media (max-width: 480px) {
    .infographic-comparison { padding: 1.2rem 1.05rem; }
    .ig-title { font-size: 1.65rem; }
  }

  /* Scroll shadows: a soft edge appears only on a side with more table to scroll to (Deep Brew gate r1). */
  .table-wrapper { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;
    background:
      linear-gradient(to right, var(--color-card, #FBF8F3) 30%, transparent) left / 40px 100% no-repeat local,
      linear-gradient(to left, var(--color-card, #FBF8F3) 30%, transparent) right / 40px 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, .28), transparent) left / 14px 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, .28), transparent) right / 14px 100% no-repeat scroll; }
  .scroll-hint { display: none; margin: 0 0 6px; font: 500 11px/1.4 var(--font-mono); letter-spacing: .08em; color: var(--color-ink-3, #75655A); }
  @media (max-width: 640px) { .scroll-hint { display: block; } }
  .table-wrapper:focus-visible { outline: 2px solid var(--color-crema-deep, #8F5D22); outline-offset: 3px; }
  .table-wrapper table { width: 100%; min-width: 560px; border-collapse: collapse; margin: 0; font-size: .875rem; line-height: 1.5; overflow-wrap: normal; }
  .table-wrapper th { min-width: 7rem; font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); padding: .75rem .625rem; text-align: left; border-bottom: 2px solid var(--color-rule, #D9CDBD); }
  .table-wrapper td { padding: 1rem .625rem; color: var(--color-ink-2, #5B4A3D); vertical-align: top; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .table-wrapper tbody tr:last-child td { border-bottom: 0; }
  .table-wrapper tbody tr:hover { background: var(--color-paper, #F3EDE3); }
  .table-wrapper .cell-name { font: 400 1.25rem/1.25 var(--font-serif); color: var(--color-ink, #2A1D15); min-width: 8rem; }
  .table-wrapper .col-result, .table-wrapper .cell-result { text-align: right; }
  .table-wrapper .cell-result { color: var(--color-crema-deep, #8F5D22); }
</style>
