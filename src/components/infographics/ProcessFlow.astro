---
interface Step {
  label: string;
  sublabel?: string;
  description: string;
  detail?: string;
}

interface CompareBox {
  title: string;
  points: string[];
}

interface Props {
  title: string;
  subtitle: string;
  steps: Step[];
  compare?: CompareBox[];
  footnote?: string;
}

const { title, subtitle, steps, compare, footnote } = Astro.props;
---

<aside class="infographic-process" aria-label={title}>
  <header class="ig-header">
    <span class="ig-brand">Step by step</span>
    <p class="ig-title">{title}</p>
    <p class="ig-subtitle">{subtitle}</p>
  </header>

  <ol class="process-timeline">
    {steps.map((step, i) => (
      <li class="process-step">
        <div class="step-marker" aria-hidden="true">
          <div class="step-dot">{i + 1}</div>
          {i < steps.length - 1 && <div class="step-line" />}
        </div>
        <div class="step-content">
          <span class="step-label">{step.label}</span>
          {step.sublabel && <span class="step-sublabel">{step.sublabel}</span>}
          <p class="step-desc">{step.description}</p>
          {step.detail && <p class="step-detail">{step.detail}</p>}
        </div>
      </li>
    ))}
  </ol>

  {compare && compare.length > 0 && (
    <div class="compare-grid">
      {compare.map((box) => (
        <div class="compare-box">
          <p class="compare-title">{box.title}</p>
          <ul class="compare-points">
            {box.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      ))}
    </div>
  )}

  {footnote && <p class="ig-footnote">{footnote}</p>}
</aside>

<style>
  /* The site's system (DESIGN_DIRECTION.md): card on paper, serif title, mono labels and numbers. */
  .infographic-process {
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.6rem 1.6rem 1.3rem;
    background: var(--color-card, #FBF8F3);
    border: 1px solid var(--color-rule, #D9CDBD);
    border-radius: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink, #2A1D15);
  }
  .ig-header { margin-bottom: 1.4rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .ig-brand {
    display: block;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-crema-deep, #8F5D22);
    margin-bottom: .6rem;
  }
  .ig-title { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .35rem; }
  .ig-subtitle { font: 500 .875rem/1.5 var(--font-mono); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  .process-timeline { list-style: none; margin: 0; padding: 0; }
  .process-step { display: flex; gap: 1rem; min-height: 4.5rem; margin: 0; padding: 0; }
  .process-step::before { display: none; }
  .step-marker { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 2rem; }
  .step-dot {
    width: 2rem; height: 2rem; border-radius: 50%;
    border: 1.5px solid var(--color-crema-deep, #8F5D22);
    color: var(--color-crema-deep, #8F5D22);
    background: var(--color-card, #FBF8F3);
    font: 500 .8125rem/1 var(--font-mono);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .step-line { width: 1.5px; flex: 1; background: var(--color-rule, #D9CDBD); margin: .3rem 0; }
  .step-content { flex: 1; min-width: 0; padding-bottom: 1.4rem; }
  .step-label { font: 400 1.35rem/1.15 var(--font-serif); color: var(--color-ink, #2A1D15); display: block; margin: .1rem 0 .15rem; }
  .step-sublabel { font: 500 .78rem/1.3 var(--font-mono); letter-spacing: .02em; color: var(--color-crema-deep, #8F5D22); display: block; margin-bottom: .45rem; }
  .step-desc { font-size: .95rem; color: var(--color-ink-2, #5B4A3D); line-height: 1.6; margin: 0 0 .3rem; }
  .step-detail { font-size: .875rem; color: var(--color-ink-3, #75655A); line-height: 1.5; margin: 0; }
  .compare-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .9rem; margin-top: 1.2rem; }
  .compare-box { background: var(--color-paper, #F3EDE3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 12px; padding: 1rem 1.2rem; }
  .compare-title { font: 400 1.2rem/1.2 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .5rem; }
  .compare-points { list-style: none; padding: 0; margin: 0; }
  .compare-points li { font-size: .875rem; color: var(--color-ink-2, #5B4A3D); padding: .2rem 0 .2rem 1rem; position: relative; }
  .compare-points li::before { content: ''; position: absolute; left: 0; top: .72rem; width: 5px; height: 5px; border-radius: 50%; background: var(--color-crema-deep, #8F5D22); }
  .ig-footnote { font-size: .875rem; color: var(--color-ink-3, #75655A); margin: .4rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--color-rule, #D9CDBD); }
  @media (max-width: 480px) {
    .infographic-process { padding: 1.2rem 1.05rem 1rem; }
    .ig-title { font-size: 1.65rem; }
    .step-label { font-size: 1.2rem; }
  }
</style>
