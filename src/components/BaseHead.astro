---
import '../styles/global.css';

// Self-hosted fonts. The site's type: Instrument Serif (display), IBM Plex Sans (text),
// IBM Plex Mono (numbers and labels). Cormorant and JetBrains Mono remain for Deep Brew
// pages until their rebuild; Inter and Playfair are kept for the not-yet-rebuilt pages.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource-variable/jetbrains-mono';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import HydrationWatch from './HydrationWatch.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	isArticle?: boolean;
	pubDate?: Date;
	updatedDate?: Date;
	/** Emit the URL-derived BreadcrumbList. Pages with their own (articles) pass false: one owner per page. */
	breadcrumbs?: boolean;
	/** Keep the page out of search results (the 404 page): no canonical, robots noindex. */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, isArticle = false, pubDate, updatedDate, breadcrumbs: emitCrumbs = true, noindex = false } = Astro.props;

// Differentiate <title> from <h1> — append site name unless this IS the homepage
const isHomepage = title === SITE_TITLE;
const pageTitle = isHomepage ? SITE_TITLE : `${title} | ${SITE_TITLE}`;

// Breadcrumb data from URL path. A segment with no page of its own is left out, so every crumb
// resolves: the category pages read Home › Blog › Brewing, since /blog/category/ has no index
// (Wave F r1, Opus). tool_wave_f_check.mjs checks every BreadcrumbList item in dist/.
const NO_PAGE = new Set(['/blog/category/']);
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = [
	{ name: 'Home', url: Astro.site?.href || 'https://jayarr.coffee/' },
	...pathSegments
		.map((seg, i) => ({ seg, path: '/' + pathSegments.slice(0, i + 1).join('/') + '/' }))
		.filter(({ path }) => !NO_PAGE.has(path))
		.map(({ seg, path }) => ({
			name: seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
			url: new URL(path, Astro.site || 'https://jayarr.coffee').href,
		})),
];
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbs.map((b, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: b.name,
		item: b.url,
	})),
};
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{/* Fonts are self-hosted via @fontsource (imported in frontmatter) */}

{/* Canonical URL (none on a noindex page such as the 404) */}
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

{/* No sitewide preconnects: gtag.js loads only on the production host, after load, so a GA hint
     would be wasted everywhere else and early even there; LiteYouTube adds the i.ytimg.com hint itself,
     only on pages that embed a video. */}

{/* A notice beside any tool that fails to load (an island that never hydrates) */}
<HydrationWatch />

{/* Primary Meta Tags */}
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />

{/* BreadcrumbList Schema */}
{emitCrumbs && pathSegments.length > 0 && (
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
<meta name="description" content={description} />

{/* Open Graph / Facebook */}
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
{isArticle && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
	<meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
<meta property="og:site_name" content={SITE_TITLE} />

{/* Twitter */}
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

{/* Pinterest Domain Verification */}
<meta name="p:domain_verify" content="54b67cdd8d98db76f65f872a6247cda4"/>

{/* Google Analytics: production hostname only, so local and preview builds send nothing.
     page_location and page_referrer drop the query string, so this code never sends tool state (GA's own
     enhanced-measurement settings must be off too: see docs/MEASUREMENT.md).
     gtag.js loads after the page so it doesn't compete with the LCP image.
     Outbound clicks to a merchant send one event, outbound_click (public/js/outbound.js, loaded only on
     this host). docs/MEASUREMENT.md has the plan. */}
<script is:inline>
	if (location.hostname === 'jayarr.coffee') {
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { dataLayer.push(arguments); };
		gtag('js', new Date());
		(function () {
			var cfg = { page_location: location.origin + location.pathname };
			var ref = document.referrer.split(/[?#]/)[0];
			if (ref) cfg.page_referrer = ref;
			gtag('config', 'G-1N7FMBHFWV', cfg);
			// The outbound-click tracker and its merchant list, only here, so no other host pays for them.
			var o = document.createElement('script');
			o.async = true;
			o.src = '/js/outbound.js';
			document.head.appendChild(o);
		})();
		addEventListener('load', () => {
			const s = document.createElement('script');
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1N7FMBHFWV';
			document.head.appendChild(s);
		});
	}
</script>
