---
interface Props {
	title: string;
	url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="flex items-center gap-4 mt-10 pt-8 border-t border-charcoal/10">
	<span class="text-xs uppercase tracking-widest text-warm-gray font-medium">Share</span>
	<div class="share-icons flex items-center">
		<!-- Twitter/X -->
		<a
			href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
			target="_blank"
			rel="noopener"
			class="share-t text-charcoal/40 hover:text-charcoal transition-colors"
			aria-label="Share on X (Twitter)"
		>
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
		</a>
		<!-- Facebook -->
		<a
			href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
			target="_blank"
			rel="noopener"
			class="share-t text-charcoal/40 hover:text-charcoal transition-colors"
			aria-label="Share on Facebook"
		>
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
		</a>
		<!-- Email -->
		<a
			href={`mailto:?subject=${encodedTitle}&body=Check out this article: ${encodedUrl}`}
			class="share-t text-charcoal/40 hover:text-charcoal transition-colors"
			aria-label="Share via email"
		>
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
		</a>
		<!-- Copy Link -->
		<button
			data-copy-url={url}
			type="button"
			class="share-t text-charcoal/40 hover:text-charcoal transition-colors cursor-pointer"
			aria-label="Copy link"
		>
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
		</button>
	</div>
	<span id="copy-feedback" class="text-xs text-crema-deep" role="status"></span>
</div>

<script>
	// The note is empty until a copy happens, so a screen reader hears it once, when it changes.
	document.querySelectorAll('[data-copy-url]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const url = (btn as HTMLElement).dataset.copyUrl;
			const feedback = document.getElementById('copy-feedback');
			if (!url || !feedback) return;
			try {
				await navigator.clipboard.writeText(url);
				feedback.textContent = 'Link copied';
			} catch {
				feedback.textContent = "Couldn't copy here; copy the address bar instead";
			}
			setTimeout(() => { feedback.textContent = ''; }, 2500);
		});
	});
</script>

<style>
	/* Each icon is 20 px, but its target is 24 px (WCAG 2.2's minimum) and 44 px on a touch screen.
	   The gaps shrink to match, so the icons sit where they did; on touch the row's extra height
	   and left inset are taken back with negative margins. */
	.share-icons { gap: 8px; }
	.share-t { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; }
	@media (pointer: coarse) {
		.share-icons { gap: 0; margin: -10px 0 -10px -12px; }
		.share-t { width: 44px; height: 44px; }
	}
</style>
