---
interface Props {
	answer: string;
}

const { answer } = Astro.props;
---

<aside class="answer-box" role="note" aria-label="Key takeaway">
	<div class="answer-label">The Short Answer</div>
	<p class="answer-text">{answer}</p>
</aside>

<style>
	.answer-box {
		max-width: 720px;
		margin: 0 auto 2rem;
		padding: 1.15rem 1.4rem 1.25rem;
		background: var(--color-card, #FBF8F3);
		border: 1px solid var(--color-rule, #D9CDBD);
		border-left: 3px solid var(--color-crema-deep, #8F5D22);
		border-radius: 0 12px 12px 0;
	}
	.answer-label {
		font: 500 11px/1 var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-crema-deep, #8F5D22);
		margin-bottom: 0.6rem;
	}
	.answer-text {
		font: 400 1.0625rem/1.65 var(--font-sans);
		color: var(--color-ink, #2A1D15);
		margin: 0;
	}
</style>
