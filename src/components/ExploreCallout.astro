---
interface Props {
	piece: 'origins' | 'methods' | 'flavors';
	context?: string;
}

const pieces: Record<string, { name: string; path: string; description: string; cta: string; icon: string }> = {
	origins: {
		name: 'The Coffee Origins',
		path: '/explore/origins/',
		description: 'When and where each origin is harvested, how high it grows and how its coffees are described.',
		cta: 'Open the map',
		icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
	},
	methods: {
		name: 'The Brewing Constellations',
		path: '/explore/methods/',
		description: 'Thirteen brewers as stars: how water meets the coffee, what filters it, what pushes it and how long it takes.',
		cta: 'Open the star chart',
		icon: 'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5z',
	},
	flavors: {
		name: 'The Flavor Bloom',
		path: '/explore/flavors/',
		description: 'Learn to taste a note, with an exercise for each, and see how often roasters use it.',
		cta: 'Open the bloom',
		icon: 'M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15a6.75 6.75 0 0 0 6.75-6.75V4.5a.75.75 0 0 0-.75-.75H6a.75.75 0 0 0-.75.75v3.75A6.75 6.75 0 0 0 12 15z',
	},
};

const { piece, context } = Astro.props;
const data = pieces[piece];
---

<aside class="explore-callout" aria-label={`Explore the ${data.name}`}>
	<div class="explore-callout-inner">
		<div class="explore-callout-icon">
			<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d={data.icon} />
			</svg>
		</div>
		<div class="explore-callout-content">
			<p class="explore-callout-label" data-pagefind-ignore>From the Explore gallery</p>
			<p class="explore-callout-title" data-pagefind-ignore>{data.name}</p>
			<p class="explore-callout-desc" data-pagefind-ignore={context ? undefined : ''}>{context || data.description}</p>
			<a href={data.path} class="explore-callout-link" data-pagefind-ignore>
				{data.cta} <span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</aside>

<style>
  .explore-callout { box-sizing: border-box; min-width: 0; max-width: 720px; margin: 2rem auto; background: var(--color-card, #FBF8F3); border: 1px solid var(--color-rule, #D9CDBD); border-left: 3px solid var(--color-crema-deep, #8F5D22); border-radius: 12px; font-family: var(--font-sans); color: var(--color-ink, #2A1D15); overflow-wrap: anywhere; }
  .explore-callout-inner { display: flex; gap: 1rem; padding: 1.25rem 1.4rem; }
  .explore-callout-icon { flex-shrink: 0; width: 32px; height: 40px; display: flex; align-items: center; justify-content: center; color: var(--color-crema-deep, #8F5D22); }
  .explore-callout-content { flex: 1; min-width: 0; }
  .explore-callout-label { font: 500 11px/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-crema-deep, #8F5D22); margin: 0 0 .45rem; }
  .explore-callout-title { font: 400 1.6rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .4rem; }
  .explore-callout-desc { font: 400 1rem/1.55 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0 0 .75rem; }
  .explore-callout-link { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; box-sizing: border-box; min-height: 44px; max-width: 100%; padding: .65rem 1rem; border-radius: 999px; background: var(--color-ink, #2A1D15); color: var(--color-paper, #F3EDE3); font: 600 14px/1.4 var(--font-sans); text-decoration: none; }
  .explore-callout-link:hover { background: var(--color-coffee, #7A4E30); color: var(--color-paper, #F3EDE3); }
  .explore-callout-link:focus-visible { outline: 2px solid var(--color-crema-deep, #8F5D22); outline-offset: 3px; }
  @media (max-width: 480px) {
    .explore-callout-inner { gap: .6rem; padding: 1.15rem 1rem; }
    .explore-callout-icon { width: 24px; }
    .explore-callout-title { font-size: 1.4rem; }
  }
</style>
