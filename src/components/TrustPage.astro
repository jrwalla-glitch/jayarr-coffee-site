---
// The shell for the pages about the site itself: About, How We Make This, the affiliate disclosure,
// privacy and terms. One column in the tool pages' type (Instrument Serif display, IBM Plex Sans text,
// IBM Plex Mono labels) on the paper ground, so they read as the same site as the tools and Explore.
// One H1, from the `title` slot.
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
	description: string;
	kicker: string;
	/** "Last updated" date for the legal pages, printed under the title. */
	updated?: string;
	/** JSON-LD objects for this page (BaseHead adds the breadcrumbs). */
	schema?: object[];
}
const { title, description, kicker, updated, schema = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
	</head>
	<body class="cf-page">
		<Header />
		<main id="main">
			<article class="cf-body tp-body">
				<p class="cf-kicker">{kicker}</p>
				<h1><slot name="title" /></h1>
				{updated && <p class="tp-updated">Last updated {updated}</p>}
				<slot name="lede" />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style is:global>.cf-page { background: #f3ede3; }</style>
<style>
	.tp-body { max-width: 720px; margin: 0 auto; padding: 120px 24px 80px; font: 400 17px/1.7 'IBM Plex Sans', 'IBM Plex Sans Metrics', system-ui, sans-serif; color: #2a1d15; }
	.cf-kicker { font: 500 12px/1 'IBM Plex Mono', 'IBM Plex Mono Metrics', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 0; }
	h1 { text-wrap: balance; font: 400 clamp(40px, 6vw, 60px)/1 'Instrument Serif', 'Instrument Serif Metrics', Georgia, serif; margin: 10px 0 14px; }
	h1 :global(em) { font-style: italic; color: #7a4e30; }
	.tp-updated { font: 400 13px/1.4 'IBM Plex Mono', 'IBM Plex Mono Metrics', monospace; color: #75655a; margin: 0 0 1.4em; }
	.tp-body :global(.lede) { font-size: 19px; color: #5b4a3d; }
	.tp-body :global(h2) { font: 400 32px/1.1 'Instrument Serif', 'Instrument Serif Metrics', Georgia, serif; margin: 40px 0 10px; }
	.tp-body :global(h3) { font: 600 17px/1.3 'IBM Plex Sans', 'IBM Plex Sans Metrics', sans-serif; margin: 26px 0 6px; }
	/* Links in running text are underlined: their color alone is too close to the ink (WCAG 1.4.1). */
	.tp-body :global(a) { color: #7a4e30; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
	.tp-body :global(a:hover) { color: #8f5d22; }
	.tp-body :global(code) { font: 400 .88em 'IBM Plex Mono', 'IBM Plex Mono Metrics', monospace; background: #ebe2d4; border-radius: 4px; padding: .1em .35em; }
	.tp-body :global(.tp-label) { font: 500 12px/1 'IBM Plex Mono', 'IBM Plex Mono Metrics', monospace; letter-spacing: .14em; text-transform: uppercase; color: #8f5d22; margin: 0 0 10px; }
	@media (max-width: 640px) { .tp-body { padding: 96px 16px 56px; } }
</style>
