---
interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	items: FAQItem[];
}

const { items } = Astro.props;

// FAQPage JSON-LD is no longer emitted (2026-10-15): an identical FAQ block on every post was a
// template signature, and Google limits FAQ rich results to a few site types. The visible FAQ stays.
// Kept for reference only:
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<section class="faq-section" aria-label="Frequently Asked Questions">
	<div class="faq-divider"></div>
	<p class="faq-heading">Frequently Asked Questions</p>
	<dl class="faq-list">
		{items.map((item) => (
			<div class="faq-item">
				<dt class="faq-question">{item.question}</dt>
				<dd class="faq-answer">{item.answer}</dd>
			</div>
		))}
	</dl>
</section>


<style>
  .faq-section { box-sizing: border-box; min-width: 0; max-width: 720px; margin: 3rem auto 0; padding: 1.6rem; background: var(--color-card, #FBF8F3); border: 1px solid var(--color-rule, #D9CDBD); border-radius: 16px; font-family: var(--font-sans); color: var(--color-ink, #2A1D15); overflow-wrap: anywhere; }
  .faq-divider { height: 1px; background: var(--color-rule, #D9CDBD); margin-bottom: 1.2rem; }
  .faq-heading { font: 400 2rem/1.1 var(--font-serif); color: var(--color-ink, #2A1D15); margin: 0 0 .5rem; }
  .faq-list { margin: 0; padding: 0; }
  .faq-item { padding: 1.2rem 0; border-bottom: 1px solid var(--color-rule, #D9CDBD); }
  .faq-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .faq-question { font: 600 1.0625rem/1.4 var(--font-sans); color: var(--color-ink, #2A1D15); margin: 0 0 .5rem; }
  .faq-answer { font: 400 1rem/1.7 var(--font-sans); color: var(--color-ink-2, #5B4A3D); margin: 0; }
  @media (max-width: 480px) {
    .faq-section { padding: 1.2rem 1.05rem; }
    .faq-heading { font-size: 1.65rem; }
  }
</style>
