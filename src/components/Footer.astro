---
import { CATEGORIES } from '../content.config';
import { TOOLS, TOOL_GROUPS } from '../data/tools';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore="all">
  <div class="inner">
    <div class="brand-col">
      <p class="brand">JayArr <em>Coffee</em></p>
      <p class="tag">Tools and guides for better coffee at home, built from published research and the JayArr Coffee video library since 2019.</p>
      <p class="contact">Corrections and questions: <a href="mailto:jay@jayarr.coffee">jay@jayarr.coffee</a></p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <p class="h">Tools</p>
        <ul>
          {TOOL_GROUPS.slice(0, 3).flatMap((g) => TOOLS.filter((t) => t.group === g.id)).map((t) => <li><a href={t.href}>{t.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="h">More tools</p>
        <ul>
          {TOOL_GROUPS.slice(3).flatMap((g) => TOOLS.filter((t) => t.group === g.id)).map((t) => <li><a href={t.href}>{t.name}</a></li>)}
          <li><a href="/tools/">All tools</a></li>
        </ul>
      </div>
      <div>
        <p class="h">Read</p>
        <ul>
          {CATEGORIES.map((c) => <li><a href={`/blog/category/${c.toLowerCase()}/`}>{c}</a></li>)}
          <li><a href="/deep-brew/research/">Deep Brew research</a></li>
          <li><a href="/videos/">Videos</a></li>
        </ul>
      </div>
      <div>
        <p class="h">About</p>
        <ul>
          <li><a href="/about/">About Jay Arr</a></li>
          <li><a href="/how-we-make-this/">How we make this</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="https://www.youtube.com/@jayarrcoffee" target="_blank" rel="noopener">YouTube</a></li>
          <li><a href="/rss.xml">RSS: articles</a></li>
          <li><a href="/deep-brew/rss.xml">RSS: Deep Brew research</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="base">
    <p>As an Amazon Associate, JayArr Coffee earns from qualifying purchases. © {year} JayArr Coffee.</p>
  </div>
</footer>

<style>
  .site-footer { background: #1f1610; color: rgba(243, 237, 227, .78); font: 400 14.5px/1.5 'IBM Plex Sans', 'IBM Plex Sans Metrics', system-ui, sans-serif; }
  .inner { max-width: 1180px; margin: 0 auto; padding: 56px 24px 36px; display: grid; grid-template-columns: 1.1fr 2.4fr; gap: 40px; }
  .brand { font: 400 30px/1 'Instrument Serif', 'Instrument Serif Metrics', Georgia, serif; color: #f3ede3; margin: 0 0 14px; }
  .brand em { color: #d9a35e; }
  .tag { margin: 0 0 14px; max-width: 20.4em; /* 34ch of Plex */ }
  .contact { margin: 0; font-size: 13.5px; }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .h { font: 500 11px/1 'IBM Plex Mono', 'IBM Plex Mono Metrics', monospace; letter-spacing: .14em; text-transform: uppercase; color: #d9a35e; margin: 0 0 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  a { color: rgba(243, 237, 227, .86); text-decoration: none; display: inline-block; padding: 4px 0; }
  a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .contact a { color: #e8c38f; }
  .base { border-top: 1px solid rgba(255, 255, 255, .1); max-width: 1180px; margin: 0 auto; padding: 18px 24px 28px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; color: rgba(243, 237, 227, .7); }
  .base p { margin: 0; }
  .base a { color: #e8c38f; padding: 0; }
  a:focus-visible { outline: 2px solid #d9a35e; outline-offset: 2px; border-radius: 3px; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
